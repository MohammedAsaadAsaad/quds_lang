    KeywordEntry(r'''use''', r'''Imports a Quds, Dart, package or relative library. Supports prefixes, section selection, show/hide, conditional imports and deferred loading.''', r'''استيراد مكتبة قدس أو Dart أو pub أو مسار نسبي، مع البادئات والأقسام والمرشحات والشروط.''', r'''use quds:math
print sqrt(9.0)'''),
    KeywordEntry(r'''export''', r'''Re-exports selected public library declarations to callers. Supports show/hide filters and sections.''', r'''إعادة تصدير التعريفات العامة لمستخدمي المكتبة، مع دعم مرشحات show وhide والأقسام.''', r'''export quds:math'''),
    KeywordEntry(r'''show''', r'''Limits an import or export to the listed names. A missing exported name is an error.''', r'''قصر الاستيراد أو التصدير على الأسماء المحددة؛ الاسم غير الموجود خطأ.''', r'''use quds:math show Fraction, gcd'''),
    KeywordEntry(r'''hide''', r'''Excludes listed names from an import or export. Explicit core filters also apply to prelude names.''', r'''استثناء أسماء من الاستيراد أو التصدير؛ تؤثر مرشحات core الصريحة على أسماء المقدمة أيضًا.''', r'''use quds:math hide Fraction'''),
    KeywordEntry(r'''deferred''', r'''Approved design: loads an imported library lazily through its prefix and loadLibrary operation. Current limitation: the compiler does not yet accept this directive suffix; the example documents approved syntax, not executable support.''', r'''تصميم معتمد لتحميل المكتبة عند الطلب. قيد حالي: لا يقبل المترجم هذه اللاحقة بعد، والمثال يشرح التصميم لا دعمًا تنفيذيًا جاهزًا.''', r'''use dart:math as math deferred'''),
    KeywordEntry(r'''when''', r'''Guards a match arm or selects a compile-time library branch. Library conditions must be constant booleans; standalone when condition: selects a compile-time block.''', r'''حارس فرع مطابقة أو شرط ثابت لفرع استيراد أو كتلة ترجمة مشروطة؛ يجب أن يكون شرط المكتبة bool ثابتًا.''', r'''use dart:io when platform == "vm"'''),
    KeywordEntry(r'''part''', r'''Includes a source part in one library. Write an unquoted module path, as with use/export: details means details.quds, and src.details means src/details.quds. Parts share privacy and must declare a matching part of. Quoted literal file paths remain accepted for compatibility.''', r'''إدراج ملف في المكتبة نفسها بمسار غير منصّص مثل src.details؛ تتشارك الملفات الخصوصية ويجب تطابق part of.''', r'''part src.details'''),
    KeywordEntry(r'''of''', r'''Completes a part of directive that identifies the owning library. Use an unquoted module path; ^.main names ../main.quds. Local path completion is available after both part and part of. The word is contextual, not a general operator.''', r'''جزء من part of لتحديد المكتبة المالكة بمسار غير منصّص؛ يشير ^.main إلى ../main.quds مع دعم إكمال المسارات.''', r'''part of ^.main'''),
    KeywordEntry(r'''async''', r'''Marks an asynchronous function or async disposal. Combine with * for an asynchronous generator. Await operations require an async context.''', r'''دالة غير متزامنة أو تخلّص غير متزامن؛ مع النجمة تصبح مولّدًا غير متزامن. تحتاج await إلى سياق async.''', r'''load() async -> int:
  return await fetch()'''),
    KeywordEntry(r'''await''', r'''Waits for asynchronous work. Also starts await for, await all: and await isolate: forms.''', r'''انتظار عمل غير متزامن، أو بدء await for وawait all: وawait isolate:.''', r'''load() async:
  value = await fetch()
  print value'''),
    KeywordEntry(r'''sync''', r'''With *, marks a synchronous generator returning an Iterable. Ordinary synchronous functions need no sync marker.''', r'''مع النجمة تعرّف مولّدًا متزامنًا يعيد Iterable؛ الدالة المتزامنة العادية لا تحتاج sync.''', r'''numbers() sync* -> int:
  yield 1
  yield 2'''),
    KeywordEntry(r'''yield''', r'''Emits a generator element. yield* delegates to another iterable or stream; it does not return from an ordinary function.''', r'''إصدار عنصر من مولّد، أو التفويض إلى مجموعة أو تدفق باستخدام yield*؛ ليست إرجاعًا من دالة عادية.''', r'''numbers() sync* -> int:
  yield 1'''),
    KeywordEntry(r'''all''', r'''In await all:, starts child expressions together and returns results as a record in source order. Failure requests cooperative cancellation.''', r'''في await all: تبدأ العمليات معًا وتعيد سجل النتائج بترتيب المصدر؛ يطلب الفشل إلغاءً تعاونيًا.''', r'''load() async:
  values = await all:
    fetchFirst()
    fetchSecond()'''),
    KeywordEntry(r'''isolate''', r'''In await isolate:, runs a top-level or static call in a new isolate. Arguments must be sendable; local captures are rejected.''', r'''في await isolate: تنفّذ استدعاءً علويًا أو ساكنًا في عزل جديد بمعاملات قابلة للإرسال ودون التقاط محليات.''', r'''load() async:
  value = await isolate:
    compute(42)'''),
    KeywordEntry(r'''task''', r'''Starts a structured task group: that waits for spawned children. Child failures cancel remaining work and produce TaskFailed.''', r'''بدء task group: التي تنتظر الأعمال المتفرعة، وتلغي البقية عند فشل طفل وتنتج TaskFailed.''', r'''run() async:
  task group:
    spawn fetch()'''),
    KeywordEntry(r'''group''', r'''Groups tests when followed by a string, or completes task group: for structured concurrency.''', r'''تجميع اختبارات عند اتباعها بنص، أو إكمال task group: للتزامن المنظم.''', r'''group "arithmetic":
  test "addition":
    expect(1 + 1, 2)'''),
    KeywordEntry(r'''spawn''', r'''Schedules child work in the current task group and isolate. It is invalid outside a task group.''', r'''جدولة عمل طفل داخل task group الحالية وفي العزل نفسه؛ لا تصلح خارج المجموعة.''', r'''run() async:
  task group:
    spawn fetch()'''),
    KeywordEntry(r'''try''', r'''Handles exceptions with catch/finally, or supplies an expression fallback with try expression else expression. Does not inspect Result errors.''', r'''التقاط الاستثناءات مع catch وfinally أو توفير بديل تعبيري؛ لا تفحص أخطاء Result.''', r'''number = try parse() else 0'''),
    KeywordEntry(r'''catch''', r'''Handles an exception, optionally with a type and a stack-trace binding. A catch body may rethrow.''', r'''التقاط استثناء مع نوع وأثر مكدس اختياريين؛ يمكن إعادة رميه داخل الجسم.''', r'''try:
  work()
catch error:
  print error'''),
    KeywordEntry(r'''finally''', r'''Runs cleanup when leaving try, including exceptional exits and returns.''', r'''تنفيذ التنظيف عند مغادرة try، بما يشمل الاستثناءات والإرجاع.''', r'''try:
  work()
finally:
  cleanup()'''),
    KeywordEntry(r'''throw''', r'''Raises an exception and leaves the normal execution path.''', r'''رمي استثناء ومغادرة مسار التنفيذ الطبيعي.''', r'''throw StateError("Invalid state")'''),
    KeywordEntry(r'''rethrow''', r'''Propagates the current caught exception with its stack trace. Only valid inside catch.''', r'''إعادة رمي الاستثناء الحالي مع أثره؛ لا تصلح خارج catch.''', r'''try:
  work()
catch error:
  print error
  rethrow'''),
    KeywordEntry(r'''assert''', r'''Checks a condition in assertion-enabled builds. Release builds can remove it; the optional message is evaluated only on failure.''', r'''فحص شرط عندما تكون التأكيدات مفعلة؛ قد تحذفه إصدارات الإنتاج، ولا تُقيّم الرسالة إلا عند الفشل.''', r'''assert count >= 0, "Negative count"'''),
    KeywordEntry(r'''require''', r'''Checks a precondition in every build and throws ArgumentError on failure. Its message is evaluated only on failure.''', r'''فحص شرط مسبق في كل الإصدارات ورمي ArgumentError؛ تُقيّم الرسالة عند الفشل فقط.''', r'''require count >= 0, "Negative count"'''),
    KeywordEntry(r'''check''', r'''Checks an invariant in every build and throws StateError on failure. Its message is evaluated only on failure.''', r'''فحص ثابت حالة في كل الإصدارات ورمي StateError؛ تُقيّم الرسالة عند الفشل فقط.''', r'''check ready, "Not ready"'''),
    KeywordEntry(r'''defer''', r'''Schedules an expression for scope exit, last in first out. Deferred work runs on returns and exceptions too.''', r'''جدولة تعبير لمغادرة النطاق بترتيب عكسي، بما يشمل الإرجاع والاستثناءات.''', r'''defer cleanup()
work()'''),
    KeywordEntry(r'''using''', r'''Binds a disposable resource and disposes it on every exit. using async awaits disposal and requires an async function.''', r'''ربط مورد والتخلّص منه في كل مسارات الخروج؛ ينتظر using async التخلّص داخل سياق غير متزامن.''', r'''using resource = openResource():
  resource.read()'''),
    KeywordEntry(r'''with''', r'''Evaluates a receiver once, applies a block of member operations, and yields that receiver. In class headers, applies mixins.''', r'''تقييم المستقبل مرة، وتنفيذ عمليات الأعضاء، ثم إعادته؛ وفي رأس الكلاس تستخدم لتطبيق المزائج.''', r'''updated = with item:
  name: "Updated"'''),
    KeywordEntry(r'''with?''', r'''Skips the receiver block when its receiver is null, yielding null; otherwise behaves as with on a promoted non-null receiver.''', r'''تجاوز الكتلة وإعادة null عندما يكون المستقبل null، وإلا تعمل على مستقبل مرقّى غير فارغ.''', r'''updated = with? item:
  name: "Updated"'''),
    KeywordEntry(r'''where''', r'''Introduces immutable names scoped to one expression. Bindings evaluate left to right before that expression. After a generic function signature, it also declares constraints such as where T is Numeric.''', r'''أسماء ثابتة محلية لتعبير تُقيّم بالترتيب، أو قيود نوع بعد توقيع دالة عامة مثل where T is Numeric.''', r'''print total / count where total = 12, count = 3'''),
    KeywordEntry(r'''let''', r'''Introduces a non-null binding in if/while or trailing conditions. The binding exists only in the successful branch or guarded statement.''', r'''ربط قيمة غير فارغة داخل شرط if أو while أو شرط لاحق؛ يتاح الاسم في المسار الناجح فقط.''', r'''if let name = nullableName:
  print name'''),
    KeywordEntry(r'''match''', r'''Matches a value against ordered patterns with optional when guards. Expression matches must be exhaustive.''', r'''مطابقة قيمة بأنماط مرتبة وحراس when اختيارية؛ يجب شمول الحالات في الصيغة التعبيرية.''', r'''text = match enabled:
  true: "yes"
  false: "no"'''),
    KeywordEntry(r'''switch''', r'''Uses the same pattern matching grammar as match. Arms do not require C-style fallthrough or break.''', r'''صياغة المطابقة نفسها التي تستخدمها match، دون سقوط بين الفروع أو break إلزامية.''', r'''switch enabled:
  true:
    print "yes"
  false:
    print "no"'''),
    KeywordEntry(r'''map''', r'''Introduces a map collection only when followed by a colon. Rows are key: value expressions; outside this form map is an identifier.''', r'''تعبير خريطة فقط عندما تتلوه النقطتان؛ كل سطر مفتاح وقيمة، وإلا تبقى الكلمة معرّفًا.''', r'''ages = map:
  "Ada": 36'''),
    KeywordEntry(r'''state''', r'''Declares a reactive cell with an initializer. Reads participate in dependency tracking.''', r'''خلية تفاعلية mutable لها مهيئ؛ تدخل قراءاتها في تتبع الاعتمادات.''', r'''state count = 0'''),
    KeywordEntry(r'''computed''', r'''Declares a non-assignable reactive value computed from tracked reads. Requires an initializer; dependency cycles are diagnosed or fail at runtime.''', r'''قيمة تفاعلية غير قابلة لإعادة الإسناد مع مهيئ؛ تُكشف دورات اعتمادها أو تفشل وقت التشغيل.''', r'''state count = 1
computed doubled = count * 2'''),
    KeywordEntry(r'''watch''', r'''Subscribes to a reactive expression for the enclosing scope. Subscription cleanup runs on every exit.''', r'''اشتراك بتعبير تفاعلي حتى نهاية النطاق المحيط، مع تنظيفه في كل مسارات الخروج.''', r'''state count = 1
watch count:
  print count'''),
    KeywordEntry(r'''batch''', r'''Delays reactive notifications until block exit and flushes once, including on exceptional exit.''', r'''تأجيل الإشعارات التفاعلية حتى نهاية الكتلة ثم تفريغها مرة، حتى عند الخروج باستثناء.''', r'''batch:
  count = 2
  total = 4'''),
    KeywordEntry(r'''event''', r'''Declares a typed event member. Handlers subscribe to the event; raise emits it.''', r'''تعريف عضو حدث ذي حمولة محددة النوع؛ يصدره raise ويستقبل اشتراكات المعالجات.''', r'''class Button:
  event clicked: (int) -> void'''),
    KeywordEntry(r'''raise''', r'''Emits a declared event with its arguments.''', r'''إصدار حدث معرّف مع معاملاته.''', r'''raise clicked(1)'''),
    KeywordEntry(r'''once''', r'''Runs a statement block at most once for its generated call site, even if the enclosing function is called repeatedly. Outside once: it remains an identifier.''', r'''تنفيذ الكتلة مرة كحد أقصى لموضع الاستدعاء المولّد؛ تبقى معرّفًا خارج once:.''', r'''tick():
  once:
    print "First call"'''),
    KeywordEntry(r'''config''', r'''Declares a typed configuration key. Lookup order is environment, quds.yaml config, then the source default. Dotted keys map to uppercase environment names with underscores.''', r'''مفتاح إعداد محدد النوع؛ أولوية البحث البيئة ثم quds.yaml ثم القيمة الافتراضية بالمصدر.''', r'''config server.port: int = 8080'''),
    KeywordEntry(r'''secret''', r'''Marks a configuration key that must not have a source initializer.''', r'''إعداد سري لا يُسمح بتهيئته بقيمة في المصدر.''', r'''config secret server.token: String'''),
    KeywordEntry(r'''test''', r'''Declares a named test at library scope or inside a test group. Run Quds tests with quds test.''', r'''تعريف اختبار مسمى في نطاق المكتبة أو داخل group؛ يُشغّل باستخدام quds test.''', r'''test "addition":
  expect(1 + 1, 2)'''),
    KeywordEntry(r'''by''', r'''Starts by lazy: initialization. A lazy immutable binding computes its value on first access.''', r'''بدء تهيئة by lazy: لارتباط ثابت تُحسب قيمته عند أول قراءة.''', r'''class Answer:
  value: int by lazy:
    result 42'''),
    KeywordEntry(r'''lazy''', r'''Completes by lazy: for deferred immutable initialization. It cannot be combined with var.''', r'''إكمال by lazy: للتهيئة المؤجلة الثابتة؛ لا تجتمع مع var.''', r'''class Answer:
  value: int by lazy:
    result 42'''),
    KeywordEntry(r'''capture''', r'''Creates a closure that snapshots the listed bindings. Snapshots are immutable and do not deep-copy object contents.''', r'''إغلاق ينسخ الارتباطات المحددة عند إنشائه؛ النسخ ثابتة ولا تنسخ محتوى الكائن بعمق.''', r'''var count = 1
read = capture(count) -> count
count = 2'''),
    KeywordEntry(r'''nameof''', r'''Produces a source-level name rather than evaluating an arbitrary expression. Use it with a supported name reference.''', r'''اسم مرجع من المصدر دون تقييم تعبير اعتباطي؛ يُستخدم مع مرجع اسم مدعوم.''', r'''name = nameof count'''),
    KeywordEntry(r'''new''', r'''Selects a constructor in a contextual dot shorthand. The expected type must determine a unique constructor.''', r'''اختيار باني في الصيغة السياقية .new؛ يجب أن يحدد النوع المتوقع بانيًا وحيدًا.''', r'''point: Point = .new(1, 2)'''),
  ]
