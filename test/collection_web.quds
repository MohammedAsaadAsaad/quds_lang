use quds:collection

_check(ok: bool, message: String):
  if not ok:
    throw StateError(message)

main():
  _check(firstOrNull([1, 2, 3]) == 1, "firstOrNull")
  _check(lastOrNull([1, 2, 3]) == 3, "lastOrNull")
  _check(singleOrNull([9]) == 9, "singleOrNull")

  chunks = chunkList([1, 2, 3, 4, 5], 2)
  _check(chunks.length == 3 and chunks[2].length == 1, "chunkList")

  parts = partitionList([1, 2, 3, 4], (n: int) -> n % 2 == 0)
  _check(parts.matching.length == 2 and parts.nonMatching.length == 2, "partitionList")

  groups = groupBy(["ant", "ape", "bat"], (s: String) -> s.substring(0, 1))
  _check(groups["a"]?.length == 2, "groupBy")

  leftMap: Map<String, int> = map:
    "a": 1
    "b": 2
  rightMap: Map<String, int> = map:
    "b": 3
    "c": 4
  merged = mergeMapsWith(leftMap, rightMap, (x: int, y: int) -> x + y)
  _check(merged["b"] == 5 and merged["c"] == 4, "mergeMapsWith")

  ms = Multiset.from(["x", "y", "x", "x"])
  top = ms.mostCommon(limit: 1)
  _check(top.length == 1 and top[0].first == "x" and top[0].second == 3, "Multiset")

  cmp = (a: int, b: int) -> a.compareTo(b)
  _check(listEquals(sortedWith([3, 1, 2], cmp), [1, 2, 3]), "sortedWith")
  _check(binarySearch([1, 3, 5, 7], 5, cmp) == 2, "binarySearch")
  shuf1 = shuffleSeeded([1, 2, 3, 4, 5], 99)
  shuf2 = shuffleSeeded([1, 2, 3, 4, 5], 99)
  _check(listEquals(shuf1, shuf2), "shuffleSeeded")
  _check(unorderedHash([1, 2, 3]) == unorderedHash([3, 1, 2]), "unorderedHash")
  steps = diffLists(["a", "b", "c"], ["a", "x", "c"])
  _check(listEquals(applyListDiff(["a", "b", "c"], steps), ["a", "x", "c"]), "diffLists")

  dq = Deque.from([2, 3])
  dq.addFirst(1)
  dq.addLast(4)
  _check(dq.removeFirst() == 1 and dq.removeLast() == 4, "Deque")

  rb = RingBuffer<int>(2)
  rb.push(10)
  rb.push(20)
  _check(rb.push(30) == 10 and rb.pop() == 20, "RingBuffer")

  pq = PriorityQueue.from([4, 1, 3], cmp)
  _check(pq.removeFirst() == 1 and pq.removeFirst() == 3, "PriorityQueue")

  lru = LruCache<String, int>(2)
  lru.put("a", 1)
  lru.put("b", 2)
  lru.get("a")
  lru.put("c", 3)
  _check(not lru.containsKey("b") and lru.peek("a") == 1, "LruCache")

  bi = BiMap<String, int>()
  bi.put("k", 7)
  _check(bi.getByValue(7) == "k", "BiMap")

  bits = BitSet(40)
  bits.setBit(1)
  bits.setBit(35)
  _check(bits.cardinality == 2 and bits.nextSetBit(2) == 35, "BitSet")

  uf = DisjointSet(4)
  uf.unite(0, 2)
  uf.unite(2, 3)
  _check(uf.connected(0, 3) and uf.componentCount == 2, "DisjointSet")

  trie = Trie<int>()
  trie.put("/a", 1)
  trie.put("/a/b", 2)
  best = trie.longestPrefixMatch("/a/b/c")
  _check(best != null and best.first == "/a/b" and best.second == 2, "Trie")

  print "COLLECTION_WEB_OK"
