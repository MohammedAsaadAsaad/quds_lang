digest() -> int:
  var total = 0
  total += sumList([4, 5, 6])
  total += minList([4, 1, 7])
  total += maxList([4, 1, 7])
  total += clampInt(12, 0, 9)
  total += factorial(6)
  total += fibonacci(10)
  total += gcd(48, 18)
  total += lcm(12, 18)
