use quds:math

class _FlowCounts:
  var checks: int = 0
  var graphs: int = 0

_flowCheck(counts: _FlowCounts, condition: bool, description: String):
  counts.checks += 1
  expect(condition, true, reason: description)

_flowSide(count: int, source: int, sink: int, mask: int) -> List<int>:
  made: List<int> = []
  var bit = 0
  var vertex = 0
  while vertex < count:
    var member = 0
    if vertex == source: member = 1
    else:
      if vertex != sink:
        if (mask & (1 << bit)) != 0: member = 1
        bit += 1
    made.add(member)
    vertex += 1
  return made

_flowMinCut(count: int, edges: List<FlowEdge>, source: int, sink: int) -> int:
  var others = count - 2
  if others < 0: others = 0
  var limit = 1
  var step = 0
  while step < others:
    limit = limit << 1
    step += 1
  var mask = 0
  var best = -1
  while mask < limit:
    inside = _flowSide(count, source, sink, mask)
    var capacity = 0
    for edge in edges:
      if edge.source != edge.target and inside[edge.source] == 1 and inside[edge.target] == 0:
        capacity += edge.capacity
    if best < 0 or capacity < best: best = capacity
    mask += 1
  return best

_flowLeaving(edges: List<FlowEdge>, side: List<int>) -> int:
  var capacity = 0
  for edge in edges:
    var from = false
    var to = false
    for vertex in side:
      if vertex == edge.source: from = true
      if vertex == edge.target: to = true
    if edge.source != edge.target and from and not to: capacity += edge.capacity
  return capacity

_flowBalance(count: int, edges: List<FlowEdge>, flows: List<int>, vertex: int) -> int:
  var net = 0
  var index = 0
  while index < edges.length:
    edge = edges[index]
    if edge.source != edge.target:
      if edge.source == vertex: net += flows[index]
      if edge.target == vertex: net -= flows[index]
    index += 1
  return net

_flowAgrees(counts: _FlowCounts, count: int, edges: List<FlowEdge>, source: int, sink: int):
  found = maximumFlow(count, edges, source, sink)
  _flowCheck(counts, found.value == _flowMinCut(count, edges, source, sink), "value is the minimum cut")
  _flowCheck(counts, _flowLeaving(edges, found.sourceSide) == found.value, "returned cut has the flow value")
  _flowCheck(counts, found.sourceSide.length > 0 and found.sourceSide[0] == source, "source starts the cut")
  var index = 0
  var sinkInside = false
  var ordered = true
  while index < found.sourceSide.length:
    if found.sourceSide[index] == sink: sinkInside = true
    if index > 0 and found.sourceSide[index] <= found.sourceSide[index - 1]: ordered = false
    index += 1
  _flowCheck(counts, not sinkInside and ordered, "sink stays outside a sorted cut")
  _flowCheck(counts, _flowBalance(count, edges, found.flows, source) == found.value, "source emits the flow")
  _flowCheck(counts, _flowBalance(count, edges, found.flows, sink) == 0 - found.value, "sink absorbs the flow")
  var vertex = 0
  while vertex < count:
    if vertex != source and vertex != sink:
      _flowCheck(counts, _flowBalance(count, edges, found.flows, vertex) == 0, "interior vertices conserve flow")
    vertex += 1
  index = 0
  while index < edges.length:
    _flowCheck(counts, found.flows[index] >= 0 and found.flows[index] <= edges[index].capacity, "edge flow respects capacity")
    index += 1
  counts.graphs += 1

_zeroRow(count: int) -> List<int>:
  made: List<int> = []
  var index = 0
  while index < count:
    made.add(0)
    index += 1
  return made

_mark(values: List<int>, index: int) -> List<int>:
  made: List<int> = []
  var cursor = 0
  while cursor < values.length:
    var bit = values[cursor]
    if cursor == index: bit = 1
    made.add(bit)
    cursor += 1
  return made

_matchSize(leftCount: int, rightCount: int, edges: List<MatchEdge>) -> int:
  var limit = 1
  var step = 0
  while step < edges.length:
    limit = limit << 1
    step += 1
  var mask = 0
  var best = 0
  while mask < limit:
    var usedL = _zeroRow(leftCount)
    var usedR = _zeroRow(rightCount)
    var size = 0
    var ok = true
    var index = 0
    while index < edges.length:
      if (mask & (1 << index)) != 0:
        edge = edges[index]
        if usedL[edge.left] == 1 or usedR[edge.right] == 1: ok = false
        usedL = _mark(usedL, edge.left)
        usedR = _mark(usedR, edge.right)
        size += 1
      index += 1
    if ok and size > best: best = size
    mask += 1
  return best

_matchAgrees(counts: _FlowCounts, leftCount: int, rightCount: int, edges: List<MatchEdge>):
  found = maximumMatching(leftCount, rightCount, edges)
  _flowCheck(counts, found.size == _matchSize(leftCount, rightCount, edges), "matching has maximum size")
  _flowCheck(counts, found.leftMate.length == leftCount and found.rightMate.length == rightCount, "mates cover both sides")
  var seen = 0
  var left = 0
  while left < leftCount:
    right = found.leftMate[left]
    if right >= 0:
      _flowCheck(counts, found.rightMate[right] == left, "mates agree")
      var linked = false
      for edge in edges:
        if edge.left == left and edge.right == right: linked = true
      _flowCheck(counts, linked, "a mate is an input edge")
      seen += 1
    left += 1
  _flowCheck(counts, seen == found.size, "size counts matched left vertices")
  counts.graphs += 1

group "integer flows and bipartite matching":
  test "Edmonds-Karp matches enumerated cuts on small networks":
    counts = _FlowCounts()
    var count = 2
    while count <= 4:
      arcs = count * (count - 1)
      var mask = 0
      var limit = 1 << arcs
      while mask < limit:
        edges: List<FlowEdge> = []
        var bit = 0
        var source = 0
        while source < count:
          var target = 0
          while target < count:
            if source != target:
              if (mask & (1 << bit)) != 0:
                edges.add(FlowEdge(source: source, target: target, capacity: 1))
              bit += 1
            target += 1
          source += 1
        _flowAgrees(counts, count, edges, 0, count - 1)
        mask += 1
      count += 1
    expect(counts.graphs, 4164)
    expect(counts.checks, 58012)
    print "QUDS FLOW CHECKS={counts.checks} GRAPHS={counts.graphs} FAILURES=0"

  test "parallel edges add, a loop carries nothing, and the input stays":
    edges = [FlowEdge(source: 0, target: 1, capacity: 2), FlowEdge(source: 0, target: 1, capacity: 3), FlowEdge(source: 1, target: 1, capacity: 9), FlowEdge(source: 1, target: 2, capacity: 4)]
    found = maximumFlow(3, edges, 0, 2)
    expect(found.value, 4)
    expect(found.flows, [2, 2, 0, 4])
    expect(edges[0].capacity, 2)
    expect(found.sourceSide, [0, 1])

  test "an unreachable sink and a larger hand network keep conservation":
    none: List<FlowEdge> = []
    expect(maximumFlow(3, none, 0, 2).value, 0)
    expect(maximumFlow(3, none, 0, 2).sourceSide, [0])
    edges = [FlowEdge(source: 0, target: 1, capacity: 3), FlowEdge(source: 0, target: 2, capacity: 2), FlowEdge(source: 1, target: 2, capacity: 1), FlowEdge(source: 1, target: 3, capacity: 2), FlowEdge(source: 2, target: 3, capacity: 4)]
    found = maximumFlow(4, edges, 0, 3)
    expect(found.value, 5)
    expect(_flowBalance(4, edges, found.flows, 1), 0)
    expect(_flowLeaving(edges, found.sourceSide), 5)

  test "invalid flow input has a distinct error and does not search":
    badEdge() -> MaximumFlow = maximumFlow(2, [FlowEdge(source: 0, target: 2, capacity: 1)], 0, 1)
    negative() -> MaximumFlow = maximumFlow(2, [FlowEdge(source: 0, target: 1, capacity: -1)], 0, 1)
    noSource() -> MaximumFlow = maximumFlow(1, [], 0, 0)
    same() -> MaximumFlow = maximumFlow(2, [], 1, 1)
    negativeCount() -> MaximumFlow = maximumFlow(-1, [], 0, 1)
    expect(badEdge, throwsA(equals("flow vertex out of range")))
    expect(negative, throwsA(equals("flow capacity must be nonnegative")))
    expect(noSource, throwsA(equals("flow source and sink must differ")))
    expect(same, throwsA(equals("flow source and sink must differ")))
    expect(negativeCount, throwsA(equals("flow vertex count must be nonnegative")))
    wide: List<FlowEdge> = []
    tooBig() -> MaximumFlow = maximumFlow(65, wide, 0, 1)
    expect(tooBig, throwsA(equals("flow exceeds the work limit")))

  test "maximum matchings agree with brute force and keep both mates":
    counts = _FlowCounts()
    var leftCount = 1
    while leftCount <= 3:
      var rightCount = 1
      while rightCount <= 3:
        possible = leftCount * rightCount
        var mask = 0
        while mask < (1 << possible):
          edges: List<MatchEdge> = []
          var bit = 0
          var left = 0
          while left < leftCount:
            var right = 0
            while right < rightCount:
              if (mask & (1 << bit)) != 0: edges.add(MatchEdge(left: left, right: right))
              bit += 1
              right += 1
            left += 1
          _matchAgrees(counts, leftCount, rightCount, edges)
          mask += 1
        rightCount += 1
      leftCount += 1
    repeated = [MatchEdge(left: 0, right: 0), MatchEdge(left: 0, right: 0), MatchEdge(left: 1, right: 1)]
    found = maximumMatching(2, 2, repeated)
    expect(found.size, 2)
    expect(found.leftMate, [0, 1])
    expect(repeated[0].right, 0)
    forced = [MatchEdge(left: 0, right: 0), MatchEdge(left: 0, right: 1), MatchEdge(left: 1, right: 0)]
    unique = maximumMatching(2, 2, forced)
    expect(unique.size, 2)
    expect(unique.leftMate, [1, 0])
    expect(unique.rightMate, [1, 0])
    expect(counts.graphs, 682)
    expect(counts.checks, 5040)
    print "QUDS MATCH CHECKS={counts.checks} GRAPHS={counts.graphs} FAILURES=0"

  test "invalid matching input names the failing bound":
    bad() -> Matching = maximumMatching(1, 1, [MatchEdge(left: 1, right: 0)])
    negative() -> Matching = maximumMatching(-1, 1, [])
    expect(bad, throwsA(equals("matching vertex out of range")))
    expect(negative, throwsA(equals("matching side count must be nonnegative")))
    none: List<MatchEdge> = []
    expect(maximumMatching(0, 0, none).size, 0)
    wide() -> Matching = maximumMatching(201, 1, none)
    expect(wide, throwsA(equals("matching exceeds the work limit")))
