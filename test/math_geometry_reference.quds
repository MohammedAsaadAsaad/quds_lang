# Generated from Python Fraction.from_float, parametric segments and Jarvis hulls.
use quds:math

class _GeomCount:
  var value: int = 0

_geomCase(counter: _GeomCount, actual: Object?, expected: Object?):
  counter.value += 1
  expect(actual, equals(expected))

_geomRational(counter: _GeomCount, actual: BigFraction, top: String, bottom: String):
  counter.value += 1
  expect(actual.numerator.toString(), top)
  expect(actual.denominator.toString(), bottom)

_geomHull(counter: _GeomCount, points: List<Vec2>, expected: List<Vec2>):
  counter.value += 1
  snapshot = points.toList()
  expect(convexHull(points), equals(expected))
  expect(points, equals(snapshot))

test "exact geometry against independent Quds reference cases":
  counter = _GeomCount()
  _geomRational(counter, binaryFraction(0.0), "0", "1")
  _geomRational(counter, binaryFraction(-0.0), "0", "1")
  _geomRational(counter, binaryFraction(5e-324), "1", "")
  _geomRational(counter, binaryFraction(-5e-324), "-1", "")
  _geomRational(counter, binaryFraction(1e-320), "253", "")
  _geomRational(counter, binaryFraction(-1e-320), "-253", "")
  _geomRational(counter, binaryFraction(2.2250738585072014e-308), "1", "")
  _geomRational(counter, binaryFraction(0.1), "3602879701896397", "36028797018963968")
  _geomRational(counter, binaryFraction(0.2), "3602879701896397", "18014398509481984")
  _geomRational(counter, binaryFraction(0.3), "5404319552844595", "18014398509481984")
  _geomRational(counter, binaryFraction(-0.1), "-3602879701896397", "36028797018963968")
  _geomRational(counter, binaryFraction(3.141592653589793), "884279719003555", "281474976710656")
  _geomRational(counter, binaryFraction(1.4142135623730951), "6369051672525773", "4503599627370496")
  _geomRational(counter, binaryFraction(1e-150), "7371020360979573", "7371020360979572953596786290992712677572111758625860211672277930167234692172165726730716260112614780354430419981960634569864423105321860610471551272329484460252725248")
  _geomRational(counter, binaryFraction(-1e+150), "-999999999999999980835596172437374590573120014030318793091164810154100112203678582976298268616221151962702060266176005440567032331208403948233373515776", "1")
  _geomRational(counter, binaryFraction(1e+308), "", "1")
  _geomRational(counter, binaryFraction(-1e+308), "-", "1")
  _geomRational(counter, binaryFraction(1.7976931348623157e+308), "", "1")
  _geomCase(counter, orientation2D(Vec2(x: 0.0, y: 0.0), Vec2(x: 1.0, y: 0.0), Vec2(x: 0.0, y: 1.0)), 1)
  _geomCase(counter, orientation2D(Vec2(x: 1e+308, y: 1e+308), Vec2(x: -1e+308, y: 1e+308), Vec2(x: 0.0, y: -1e+308)), 1)
