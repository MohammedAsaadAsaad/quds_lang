use quds:text
use quds:ext

_throws(action: () -> void) -> bool:
  try:
    action()
    return false
  catch _:
    return true

test "batch 0 baseline: core String helpers and quds:ext Text methods":
  expect("abcdef".take(3) == "abc", true)
  expect("abcdef".drop(2) == "cdef", true)
  expect("abcdef".takeLast(2) == "ef", true)
  expect("abcdef".dropLast(2) == "abcd", true)
  expect("42".padStart(4, "0") == "0042", true)
  expect("42".padEnd(4, ".") == "42..", true)
  expect("ab".chars.length == 2, true)
  expect("a\nb".lines.length == 2, true)

  expect("".blank(), true)
  expect("   ".blank(), true)
  expect(not " a ".blank(), true)
  expect("ab".capitalized() == "Ab", true)
  expect("".capitalized() == "", true)
  expect("abc".reversed() == "cba", true)
  expect("ababa".count("aba") == 2, true)
  expect("abc".count("") == 0, true)
  expect("prefix-val".removePrefix("prefix-") == "val", true)
  expect("val".removePrefix("prefix-") == "val", true)
  expect("val-suffix".removeSuffix("-suffix") == "val", true)
  expect("val".removeSuffix("-suffix") == "val", true)
  expect("a-b-c".before("-") == "a", true)
  expect("abc".before("-") == "abc", true)
  expect("a-b-c".after("-") == "b-c", true)
  expect("abc".after("-") == "", true)
  expect("ab".repeated(3) == "ababab", true)
  expect("ab".repeated(0) == "", true)
  expect("ab".repeated(-1) == "", true)
  expect("  a  b c ".words().length == 3, true)
  expect("abcdef".truncate(3) == "abc", true)
  expect("abcdef".truncate(0) == "", true)
  expect("abcdef".truncate(-2) == "", true)
  expect("ab".quoted() == "\"ab\"", true)

test "types: TextRange, TextSpan, TextPosition, validate, intersect, position/offset":
  expect(TextBoundaryPolicy.reject != TextBoundaryPolicy.previous, true)
  expect(TextBoundaryPolicy.values.length == 3, true)
  expect(TextBoundaryPolicy.next.name == "next", true)

  r = TextRange(1, 4)
  expect(r.start == 1, true)
  expect(r.end == 4, true)
  expect(r.length == 3, true)
  expect(not r.isEmpty, true)
  expect(r.isNotEmpty, true)
  expect(r.contains(1), true)
  expect(r.contains(3), true)
  expect(not r.contains(0), true)
  expect(not r.contains(4), true)
  expect(r.overlaps(TextRange(3, 5)), true)
  expect(not r.overlaps(TextRange(4, 6)), true)
  expect(r == TextRange(1, 4), true)
  expect(TextRange(2, 2).isEmpty, true)

  expect(_throws(() -> TextRange(-1, 2)), true)
  expect(_throws(() -> TextRange(4, 2)), true)

  validated = validateTextRange("hello", TextRange(0, 5))
  expect(validated == TextRange(0, 5), true)
  expect(_throws(() -> validateTextRange("hi", TextRange(0, 3))), true)

  expect(intersectTextRanges(TextRange(0, 4), TextRange(2, 6)) == TextRange(2, 4), true)
  expect(intersectTextRanges(TextRange(0, 2), TextRange(2, 4)) == null, true)
  expect(intersectTextRanges(TextRange(0, 2), TextRange(5, 6)) == null, true)
  expect(intersectTextRanges(TextRange(2, 2), TextRange(0, 4)) == TextRange(2, 2), true)

  span = TextSpan("hello world", TextRange(0, 5))
  expect(span.value == "hello", true)
  expect(span.length == 5, true)
  expect(not span.isEmpty, true)
  sub = span.slice(1, 4)
  expect(sub.value == "ell", true)
  expect(sub.range == TextRange(1, 4), true)
  mat = sub.materialize()
  expect(mat.source == "ell", true)
  expect(mat.range == TextRange(0, 3), true)
  expect(mat.value == "ell", true)
  expect(_throws(() -> span.slice(0, 6)), true)
  expect(_throws(() -> TextSpan("hi", TextRange(0, 3))), true)

  sample = "ab\r\ncd\nef\rgh"
  expect(textPositionAt(sample, 0) == TextPosition(0, 1, 1), true)
  expect(textPositionAt(sample, 2) == TextPosition(2, 1, 3), true)
  expect(textPositionAt(sample, 3) == TextPosition(3, 1, 4), true)
  expect(textPositionAt(sample, 4) == TextPosition(4, 2, 1), true)
  expect(textPositionAt(sample, 6) == TextPosition(6, 2, 3), true)
  expect(textPositionAt(sample, 7) == TextPosition(7, 3, 1), true)
  expect(textPositionAt(sample, 10) == TextPosition(10, 4, 1), true)
  expect(textPositionAt(sample, sample.length) == TextPosition(12, 4, 3), true)

  expect(textOffsetAt(sample, 1, 1) == 0, true)
  expect(textOffsetAt(sample, 1, 3) == 2, true)
  expect(textOffsetAt(sample, 2, 1) == 4, true)
  expect(textOffsetAt(sample, 2, 3) == 6, true)
  expect(textOffsetAt(sample, 3, 1) == 7, true)
  expect(textOffsetAt(sample, 4, 3) == 12, true)
  expect(_throws(() -> textPositionAt(sample, -1)), true)
  expect(_throws(() -> textPositionAt(sample, 99)), true)
  expect(_throws(() -> textOffsetAt(sample, 0, 1)), true)
  expect(_throws(() -> textOffsetAt(sample, 1, 0)), true)
  expect(_throws(() -> textOffsetAt(sample, 5, 1)), true)
  expect(_throws(() -> textOffsetAt(sample, 1, 4)), true)

test "inspect: blank, hasText, blankTextToNull, containsOnly, lineBreak, wellFormed":
  nbsp = String.fromCharCode(0x00A0)
  emSpace = String.fromCharCode(0x2003)
  ideographicSpace = String.fromCharCode(0x3000)
  lineSep = String.fromCharCode(0x2028)
  expect(isBlankText(""), true)
  expect(isBlankText("   \t\r\n" + nbsp + emSpace + ideographicSpace), true)
  expect(not isBlankText(" a "), true)
  expect(not isBlankText("قدس"), true)

  expect(hasText("Quds"), true)
  expect(not hasText(null), true)
  expect(not hasText(" \t "), true)

  expect(blankTextToNull(null) == null, true)
  expect(blankTextToNull("  " + nbsp + " ") == null, true)
  expect(blankTextToNull("  hi  ") == "  hi  ", true)

  expect(containsOnlyCharacters("", ["a"]), true)
  expect(containsOnlyCharacters("10110", ["0", "1"]), true)
  expect(not containsOnlyCharacters("102", ["0", "1"]), true)
  expect(containsOnlyCharacters("😀😁", ["😀", "😁"]), true)

  expect(hasLineBreak("a\nb"), true)
  expect(hasLineBreak("a\rb"), true)
  expect(hasLineBreak("a" + lineSep + "b"), true)
  expect(not hasLineBreak("single line"), true)

  expect(isWellFormedUnicode(""), true)
  expect(isWellFormedUnicode("hello قدس 😀"), true)
  loneHigh = String.fromCharCode(0xD800)
  loneLow = String.fromCharCode(0xDC00)
  expect(not isWellFormedUnicode("a" + loneHigh + "b"), true)
  expect(not isWellFormedUnicode("a" + loneLow), true)
  expect(not isWellFormedUnicode(loneHigh), true)

test "slice: sliceText, before/after/last, between, textWindows":
  expect(sliceText("hello world", TextRange(6, 11)) == "world", true)
  expect(sliceText("hello", TextRange(2, 2)) == "", true)
  expect(_throws(() -> sliceText("hi", TextRange(0, 5))), true)

  expect(beforeText("a=b=c", "=") == "a", true)
  expect(beforeText("abc", "=") == null, true)
  expect(afterText("a=b=c", "=") == "b=c", true)
  expect(afterText("abc", "=") == null, true)
  expect(beforeLastText("a=b=c", "=") == "a=b", true)
  expect(beforeLastText("abc", "=") == null, true)
  expect(afterLastText("a=b=c", "=") == "c", true)
  expect(afterLastText("abc", "=") == null, true)
  expect(betweenText("pre[one][two]", "[", "]") == "one", true)
  expect(betweenText("a::b::c", "::", "::") == "b", true)
  expect(betweenText("no-end[abc", "[", "]") == null, true)
  expect(betweenText("no-start]abc", "[", "]") == null, true)
  expect(_throws(() -> beforeText("a", "")), true)
  expect(_throws(() -> afterText("a", "")), true)
  expect(_throws(() -> beforeLastText("a", "")), true)
  expect(_throws(() -> afterLastText("a", "")), true)
  expect(_throws(() -> betweenText("a", "", "b")), true)
  expect(_throws(() -> betweenText("a", "b", "")), true)

  w1 = textWindows("abcd", 2)
  expect(w1.length == 3, true)
  expect(w1[0] == "ab" and w1[1] == "bc" and w1[2] == "cd", true)
  w2 = textWindows("abcde", 2, step: 2)
  expect(w2.length == 2, true)
  expect(w2[0] == "ab" and w2[1] == "cd", true)
  expect(textWindows("a", 3).isEmpty, true)
  expect(_throws(() -> textWindows("ab", 0)), true)
  expect(_throws(() -> textWindows("ab", 1, step: 0)), true)

test "split: splitText, splitTextAny, splitTextOnce, splitTextLastOnce, textSegments":
  p1 = splitText("a,,b,", ",")
  expect(p1.length == 4, true)
  expect(p1[0] == "a" and p1[1] == "" and p1[2] == "b" and p1[3] == "", true)

  p2 = splitText("a,,b,", ",", keepEmpty: false)
  expect(p2.length == 2, true)
  expect(p2[0] == "a" and p2[1] == "b", true)

  p3 = splitText("a,b,c,d", ",", maxSplits: 2)
  expect(p3.length == 3, true)
  expect(p3[0] == "a" and p3[1] == "b" and p3[2] == "c,d", true)

  p0 = splitText("a,b", ",", maxSplits: 0)
  expect(p0.length == 1 and p0[0] == "a,b", true)

  pk = splitText("a,b,c", ",", keepSeparators: true)
  expect(pk.length == 5, true)
  expect(pk[1] == "," and pk[3] == ",", true)

  # Longest match wins at same offset ("--" beats "-").
  pa = splitTextAny("a--b-c", ["-", "--"], keepSeparators: true)
  expect(pa.length == 5, true)
  expect(pa[0] == "a" and pa[1] == "--" and pa[2] == "b" and pa[3] == "-" and pa[4] == "c", true)

  once = splitTextOnce("name=a=b", "=")
  expect(once == TextPartition("name", "=", "a=b", true), true)
  miss = splitTextOnce("plain", "=")
  expect(miss == TextPartition("plain", "", "", false), true)

  lastOnce = splitTextLastOnce("a/b/c", "/")
  expect(lastOnce == TextPartition("a/b", "/", "c", true), true)
  expect(not splitTextLastOnce("plain", "/").found, true)

  segs = textSegments("x,,y", ",")
  expect(segs.length == 3, true)
  expect(segs[0].range == TextRange(0, 1) and segs[0].value == "x", true)
  expect(segs[1].range == TextRange(2, 2) and segs[1].value == "", true)
  expect(segs[2].range == TextRange(3, 4) and segs[2].value == "y", true)

  opts = TextSplitOptions(keepEmpty: false, maxSplits: 1, keepSeparators: true)
  expect(not opts.keepEmpty and opts.maxSplits == 1 and opts.keepSeparators, true)
  expect(_throws(() -> TextSplitOptions(maxSplits: -1)), true)
  expect(_throws(() -> splitText("a", "")), true)
  expect(_throws(() -> splitText("a", ",", maxSplits: -1)), true)
  expect(_throws(() -> splitTextAny("a", [])), true)
  expect(_throws(() -> splitTextAny("a", [""])), true)
  expect(_throws(() -> splitTextOnce("a", "")), true)
  expect(_throws(() -> splitTextLastOnce("a", "")), true)
  expect(_throws(() -> textSegments("a", "")), true)

test "compose: join, joinNonBlank, repeat, surround, ensurePrefix/Suffix, interleave":
  emptyParts: List<String> = []
  expect(joinText(["a", "b", "c"], separator: ", ") == "a, b, c", true)
  expect(joinText(emptyParts, separator: ",") == "", true)
  expect(joinNonBlankText(["a", "", "  \t ", "b", String.fromCharCode(0x00A0), "c"], separator: "-") == "a-b-c", true)

  expect(repeatText("some", 3, separator: "-") == "some-some-some", true)
  expect(repeatText("x", 0, separator: "-") == "", true)
  expect(repeatText("x", 1, separator: "-") == "x", true)
  expect(repeatText("ab", 3) == "ababab", true)
  expect(_throws(() -> repeatText("x", -1)), true)

  expect(surroundText("quds", "[", "]") == "[quds]", true)
  expect(surroundText("quds", "*", "*") == "*quds*", true)
  expect(ensureTextPrefix("home", "/") == "/home", true)
  expect(ensureTextPrefix("/home", "/") == "/home", true)
  expect(ensureTextSuffix("dir", "/") == "dir/", true)
  expect(ensureTextSuffix("dir/", "/") == "dir/", true)

  parts: List<String> = []
  for item in interleaveText(["a", "b", "c"], "|"):
    parts.add(item)
  expect(parts.length == 5, true)
  expect(joinText(parts) == "a|b|c", true)

test "builder: TextBuilder linear building, single-pass, codePoint, clear":
  b = TextBuilder()
  expect(b.isEmpty, true)
  expect(not b.isNotEmpty, true)
  expect(b.utf16Length == 0, true)

  b.append("Hello")
  b.appendLine(" Quds")
  b.appendJoined(["a", "b", "c"], separator: ", ")
  b.appendAll(["!", "!"])
  b.appendCodePoint(0x1F600)
  built = b.build()
  expect(built == "Hello Quds\na, b, c!!😀", true)
  expect(b.utf16Length == built.length, true)
  expect(b.isNotEmpty, true)

  b.append(" extra")
  expect(built == "Hello Quds\na, b, c!!😀", true)
  b.clear()
  expect(b.isEmpty, true)
  expect(b.build() == "", true)
  expect(_throws(() -> b.appendCodePoint(-1)), true)
  expect(_throws(() -> b.appendCodePoint(0xD800)), true)
  expect(_throws(() -> b.appendCodePoint(0x110000)), true)

test "lines: TextLines, splitTextLines, joinTextLines, normalize, indent, dedent, trimBlankLines":
  sample = "a\r\nb\rc\n"
  view = TextLines(sample)
  expect(view.count == 3, true)
  expect(view.lineAt(0).content == "a" and view.lineAt(0).ending == "\r\n", true)
  expect(view.lineAt(0).contentRange == TextRange(0, 1), true)
  expect(view.lineAt(0).fullRange == TextRange(0, 3), true)
  expect(view.lineAt(1).content == "b" and view.lineAt(1).ending == "\r", true)
  expect(view.lineAt(2).content == "c" and view.lineAt(2).ending == "\n", true)
  expect(_throws(() -> view.lineAt(3)), true)

  keep = TextLines(sample, keepTrailingEmpty: true)
  expect(keep.count == 4, true)
  expect(keep.lineAt(3).content == "" and keep.lineAt(3).ending == "", true)

  expect(splitTextLines("").isEmpty, true)
  expect(splitTextLines("a\r\nb\n").length == 2, true)
  expect(splitTextLines("a\r\nb\n", keepTrailingEmpty: true).length == 3, true)

  expect(joinTextLines(["a", "b"]) == "a\nb", true)
  expect(joinTextLines(["a", "b"], ending: TextLineEnding.crlf, trailingNewline: true) == "a\r\nb\r\n", true)
  expect(joinTextLines(["a", "b"], ending: TextLineEnding.cr) == "a\rb", true)

  expect(normalizeLineEndings("a\r\nb\rc\nd") == "a\nb\nc\nd", true)
  expect(normalizeLineEndings("a\nb", ending: TextLineEnding.crlf) == "a\r\nb", true)

  expect(indentText("a\n\nb", "  ", skipBlankLines: true) == "  a\n\n  b", true)
  expect(indentText("a\r\nb", "> ") == "> a\r\n> b", true)

  expect(dedentText("    a\n      b\n\n    c") == "a\n  b\n\nc", true)
  expect(dedentText("\ta\n\tb", preserveTabs: true) == "a\nb", true)
  expect(dedentText("\ta\n  b", preserveTabs: true) == "\ta\n  b", true)
  expect(dedentText("\ta\n\tb", preserveTabs: false) == "\ta\n\tb", true)

  expect(trimBlankLines("\n  \nfirst\n\nsecond\n  \n") == "first\n\nsecond", true)
  expect(trimBlankLines("  \n\t\n  ") == "", true)
