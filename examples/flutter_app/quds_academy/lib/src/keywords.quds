    KeywordEntry(r'''out''', r'''Declares output variance for a generic parameter. Uses must be sound in output positions.''', r'''تباين الإخراج لمعامل نوع عام، ويجب أن تكون استعمالاته سليمة في مواضع الإخراج.''', r'''interface Source<out T>:
