use fixtures/function_values/api.dart as native

main():
  next = native.increment
  add = native.makeCounter().add
  read = native.Box<int>(4).read
  print next(1)
  print add(2)
  print read()
  print native.receiverCount()
  optional: ([value: int]) -> int = native.optional
  mixed: (int, last: int required, middle: int = 0, nullable: int? = null) -> String = native.combine
  print optional()
  print mixed(1, last: 3)
  print native.invokeOptional(native.optional)
  print native.invokeNamed(native.named)
  print native.invokeCombined(native.combine)
  native.resetTrace()
  print native.makeNamed()(native.tick("A", 1), last: native.tick("B", 3), middle: native.tick("D", 2))
  print native.trace()
  generic = native.identity<int>
  staticGeneric = native.Counter.staticIdentity<String>
  boundedMethod = native.Box<num>(1).select<int>
  nullableReceiver: native.Counter? = native.Counter(2)
  nullableMethod = nullableReceiver?.identity<int>
  print generic(13)
  print staticGeneric("generic")
  print boundedMethod(14)
  print nullableMethod!(15)
