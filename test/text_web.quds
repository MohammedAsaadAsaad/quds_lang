use quds:text

main():
  r = TextRange(0, 4)
  assert sliceText("QudsLang", r) == "Quds"
  assert isBlankText(" \t\r\n")
  assert beforeText("k=v", "=") == "k"
  part = splitTextOnce("a=b=c", "=")
  assert part.found and part.before == "a" and part.after == "b=c"
  assert repeatText("ha", 3, separator: "-") == "ha-ha-ha"
  b = TextBuilder()
  b.append("Hello")
  b.appendLine(" Quds")
  b.appendCodePoint(0x1F600)
  assert b.build() == "Hello Quds\n😀"
  assert normalizeLineEndings("a\r\nb\rc") == "a\nb\nc"
  assert dedentText("  a\n  b") == "a\nb"
  chars = TextCharacters("قُدس 👨‍👩‍👧‍👦")
  assert chars.count == 5 and chars.characterAt(0) == "قُ" and chars.characterAt(4) == "👨‍👩‍👧‍👦"
  assert sliceCharacters("قُدس", 0, 2) == "قُد"
  assert reverseCharacters("قُدس") == "سدقُ"
  assert normalizeUnicode("e" + String.fromCharCode(0x0301)) == String.fromCharCode(0x00E9)
  assert caseFoldText("Straße") == "strasse"
  print "TEXT SDK VM WEB OK"
