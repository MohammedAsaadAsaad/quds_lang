  return parts.sum()

main():
  product = Product(sku: "A1", cents: 250, stock: 4)
  shift = Shift(start: 22 * 60, end: 6 * 60)
  print "day"
  print digest()
  print product.value()
  print product.low()
  print shift.minutes()
  print letterGrade(92)
  print sumList([4, 5, 6])
