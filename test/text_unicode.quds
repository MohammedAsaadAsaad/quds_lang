use quds:text::types
use quds:text::unicode
use quds:text::inspect
use quds:text::slice

_throws(action: () -> void) -> bool:
  try:
    action()
    return false
  catch _:
    return true

test "unicode: TextCodePoints strict, replacement, ranges, and iter":
  cps = TextCodePoints("A😀ب")
  expect(cps.count == 3, true)
  expect(not cps.isEmpty and cps.isNotEmpty, true)
  expect(cps.codePointAt(0) == 65, true)
  expect(cps.codePointAt(1) == 0x1F600, true)
  expect(cps.codePointAt(2) == 0x0628, true)
  expect(cps.rangeAt(0) == TextRange(0, 1), true)
  expect(cps.rangeAt(1) == TextRange(1, 3), true)
  expect(cps.rangeAt(2) == TextRange(3, 4), true)
  expect(cps.offsetFor(0) == 0, true)
  expect(cps.offsetFor(1) == 1, true)
  expect(cps.offsetFor(2) == 3, true)
  expect(cps.offsetFor(3) == 4, true)
  expect(_throws(() -> cps.codePointAt(-1)), true)
  expect(_throws(() -> cps.codePointAt(3)), true)
  expect(_throws(() -> cps.offsetFor(4)), true)

  collected: List<int> = []
  for cp in cps.iter():
    collected.add(cp)
  expect(collected.length == 3 and collected[1] == 0x1F600, true)

  lone = String.fromCharCode(0xD800) + "x" + String.fromCharCode(0xDC00)
  raw = TextCodePoints(lone)
  expect(raw.count == 3, true)
  expect(raw.codePointAt(0) == 0xD800, true)
  expect(raw.codePointAt(2) == 0xDC00, true)
  replaced = TextCodePoints(lone, replaceMalformed: true)
  expect(replaced.codePointAt(0) == 0xFFFD, true)
  expect(replaced.codePointAt(1) == 120, true)
  expect(replaced.codePointAt(2) == 0xFFFD, true)
  expect(_throws(() -> TextCodePoints(lone, strict: true)), true)

test "unicode: TextCharacters grapheme clusters (Arabic diacritics, ZWJ emoji, flags, CRLF, Hangul)":
  sample = "قُدس 👨‍👩‍👧‍👦"
  chars = TextCharacters(sample)
  expect(chars.count == 5, true)
  expect(chars.characterAt(0) == "قُ", true)
  expect(chars.characterAt(1) == "د", true)
  expect(chars.characterAt(2) == "س", true)
  expect(chars.characterAt(3) == " ", true)
  expect(chars.characterAt(4) == "👨‍👩‍👧‍👦", true)
  expect(chars.rangeAt(0) == TextRange(0, 2), true)
  expect(chars.slice(0, 2) == "قُد", true)
  expect(chars.slice(4, 5) == "👨‍👩‍👧‍👦", true)
  expect(sliceCharacters(sample, 0, 3) == "قُدس", true)
  expect(reverseCharacters("قُدس") == "سدقُ", true)
  expect(reverseCharacters("a👨‍👩‍👧‍👦b") == "b👨‍👩‍👧‍👦a", true)

  flags = TextCharacters("🇵🇸🇺🇸")
  expect(flags.count == 2, true)
  expect(flags.characterAt(0) == "🇵🇸", true)
  expect(flags.characterAt(1) == "🇺🇸", true)
  expect(reverseCharacters("🇵🇸🇺🇸") == "🇺🇸🇵🇸", true)

  crlf = TextCharacters("a\r\nb")
  expect(crlf.count == 3, true)
  expect(crlf.characterAt(1) == "\r\n", true)

  skin = TextCharacters("👋🏽!")
  expect(skin.count == 2, true)
  expect(skin.characterAt(0) == "👋🏽", true)

  jamo = TextCharacters(String.fromCharCodes([0x1112, 0x1161, 0x11AB]))
  expect(jamo.count == 1, true)

  expect(containsOnlyCharacters("قُدس", ["قُ", "د", "س"]), true)
  expect(not containsOnlyCharacters("قُدس", ["ق", "د", "س"]), true)

  # Boundary policy on UTF-16 offset inside surrogate/grapheme cluster
  expect(chars.boundaryOffset(0) == 0, true)
  expect(chars.boundaryOffset(2) == 2, true)
  expect(_throws(() -> chars.boundaryOffset(1, policy: TextBoundaryPolicy.reject)), true)
  expect(chars.boundaryOffset(1, policy: TextBoundaryPolicy.previous) == 0, true)
  expect(chars.boundaryOffset(1, policy: TextBoundaryPolicy.next) == 2, true)

test "unicode: TextNormalizer, normalizeUnicode, isNormalizedUnicode, caseFoldText":
  decomposed = "e" + String.fromCharCode(0x0301)
  composed = String.fromCharCode(0x00E9)
  nfc = TextNormalizer(TextNormalizationForm.nfc)
  nfd = TextNormalizer(TextNormalizationForm.nfd)
  expect(nfc.normalize(decomposed) == composed, true)
  expect(nfc.isNormalized(composed), true)
  expect(not nfc.isNormalized(decomposed), true)
  expect(nfd.normalize(composed) == decomposed, true)
  expect(nfd.isNormalized(decomposed), true)
  expect(not nfd.isNormalized(composed), true)

  ligature = String.fromCharCode(0xFB01)
  expect(normalizeUnicode(ligature, form: TextNormalizationForm.nfkc) == "fi", true)
  expect(normalizeUnicode(ligature, form: TextNormalizationForm.nfkd) == "fi", true)
  expect(normalizeUnicode(ligature, form: TextNormalizationForm.nfc) == ligature, true)

  expect(caseFoldText("Straße") == "strasse", true)
  expect(caseFoldText("HELLO") == "hello", true)
  expect(caseFoldText("ΌΣΟΣ") == caseFoldText("όσος"), true)
