use fixtures.union_boundaries.provider as api

local(value: int | String) -> String:
  if value is int:
    return "n{value}"
  return "s{value}"

test "union calls wrap and narrowing unwraps":
  saved = local
  expect(saved(1), "n1")
  expect(local("a"), "sa")
  taken = api.classify
  expect(taken(2), "n2")
  expect(api.classify("b"), "sb")
  held: int | String = 3
  if held is int:
    expect(held + 1, 4)
