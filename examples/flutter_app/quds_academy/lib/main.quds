    content = (if (width > 820.0): (Row(crossAxisAlignment: CrossAxisAlignment.center, children: [Expanded(child: intro), SizedBox(width: 34.0), SizedBox(width: 330.0, child: AnimatedRotation(turns: (if (arabic): (-0.012) else: (0.012)), duration: motion(context, 500), curve: Curves.easeOutCubic, child: demo))])) else: (Column(crossAxisAlignment: CrossAxisAlignment.stretch, children: [intro, SizedBox(height: 28.0), demo])))
    return Entrance(child: Container(padding: EdgeInsets.all((if (width > 600.0): (32.0) else: (22.0))), decoration: BoxDecoration(color: (if (dark): (Color(0xFF1C3931)) else: (Color(0xFFEDF3E8))), borderRadius: BorderRadius.circular(26.0)), child: content))

  metric(context: BuildContext, value: String, title: String,
  icon: IconData) -> Widget:
    return Expanded(child: Row(children: [Container(padding: EdgeInsets.all(10.0), decoration: BoxDecoration(color: brand().withValues(alpha: 0.08), borderRadius: BorderRadius.circular(12.0)), child: Icon(icon, color: brand(), size: 21.0)), SizedBox(width: 12.0), Flexible(child: Column(crossAxisAlignment: CrossAxisAlignment.start, children: [Text(value, style: TextStyle(fontSize: 21.0, fontWeight: FontWeight.w800, color: ink(context))), Text(title, style: TextStyle(fontSize: 11.0, color: muted(context)))]))]))

  courseCard(context: BuildContext, index: int) -> Widget:
    var done = 0
    for lesson in catalog:
      if lesson.track == index:
        done += (if (completed.contains(lesson.id)): (1) else: (0))
    icons = [Icons.terminal_rounded, Icons.alt_route_rounded,
    Icons.view_in_ar_rounded, Icons.rocket_launch_rounded]
    descriptionsEn = ["Meet the syntax. Find your voice.",
    "Functions, decisions, and flow.", "Collections, objects, and safe types.",
    "Libraries, conversions, and real SQL."]
    descriptionsAr = ["تعرّف إلى الصياغة، واعثر على أسلوبك.",
    "دوال وقرارات ومسار تنفيذ واضح.", "مجموعات وكائنات وأنواع آمنة.",
    "مكتبات وتحويلات وقواعد بيانات حقيقية."]
    open = () -> :
      for position in 0..<catalog.length:
        if catalog[position].track == index:
          openLesson(position)
          break
    child = Column(crossAxisAlignment: CrossAxisAlignment.start,
    children: [Row(children: [Container(padding: EdgeInsets.all(13.0),
    decoration: BoxDecoration(color: [Color(0xFFEEF2E3), Color(0xFFE8EEF7),
    Color(0xFFF7EEE4),
    Color(0xFFF0EAF5)][index], borderRadius: BorderRadius.circular(14.0)), child: Icon(icons[index], color: [brand(), Color(0xFF557CAB), Color(0xFFB8834B), Color(0xFF9070AB)][index], size: 26.0)), Spacer(), Text("0{index + 1}", style: TextStyle(color: muted(context), fontSize: 12.0, fontFamily: "JetBrainsMono"))]), SizedBox(height: 19.0), heading(context, trackName(index, arabic), 20.0), SizedBox(height: 5.0), prose(context, (if (arabic): (descriptionsAr[index]) else: (descriptionsEn[index]))), SizedBox(height: 21.0), Row(children: [Icon(Icons.menu_book_outlined, size: 14.0, color: muted(context)), SizedBox(width: 5.0), Text(tr("3 lessons", "3 دروس"), style: TextStyle(fontSize: 11.0, color: muted(context))), SizedBox(width: 13.0), Text(tr("~18 min", "نحو 18 دقيقة"), style: TextStyle(fontSize: 11.0, color: muted(context))), Spacer(), Icon(Icons.arrow_forward_rounded, size: 20.0, color: brand())]), SizedBox(height: 14.0), ClipRRect(borderRadius: BorderRadius.circular(20.0), child: LinearProgressIndicator(value: done / 3.0, minHeight: 4.0, color: brand(), backgroundColor: brand().withValues(alpha: 0.08)))])
    return Entrance(order: index + 1, child: InteractivePanel(onTap: open,
    child: child))

  overview(context: BuildContext, width: double) -> Widget:
    visible: List<int> = []
    for index in 0..<catalog.length:
      lesson = catalog[index]
      if (lesson.titleEn + lesson.titleAr + lesson.descriptionEn + lesson.descriptionAr).toLowerCase().contains(query): visible.add(index)
    cards: List<Widget> = []
    if query.isEmpty:
      for index in 0..<4:
        cards.add(SizedBox(width: (if (width > 650.0): ((width - 16.0) / 2.0) else: (width)), child: courseCard(context, index)))
    else:
      for index in visible:
        cards.add(SizedBox(width: width, child: lessonTile(context, index)))
    return Column(crossAxisAlignment: CrossAxisAlignment.stretch,
    children: [hero(context, width), SizedBox(height: 24.0), panel(context,
    Row(children: [metric(context, "12", tr("crafted lessons", "درسًا متقنًا"),
    Icons.auto_stories_outlined), metric(context, "{completed.length}",
    tr("completed", "دروس مكتملة"),
    Icons.check_circle_outline_rounded), if width > 450.0: metric(context,
    "{completed.length * 25}", tr("learning points", "نقطة تعلّم"),
