    KeywordEntry(r'''as''', r'''Checks/casts a value to a type without invoking a conversion. Also names an import prefix and annotates patterns.''', r'''فحص ملاءمة النوع دون استدعاء تحويل؛ وتسمية بادئة الاستيراد أو توصيف نمط.''', r'''use quds:math as math
print math.sqrt(9.0)'''),
    KeywordEntry(r'''to''', r'''Converts a value to a target type. Failure throws ConversionError; to? returns null on conversion failure. Custom conversion selection is static and one hop.''', r'''تحويل إلى النوع المستهدف أو رمي ConversionError؛ تُختار التحويلات ساكنًا وبخطوة واحدة.''', r'''number = "42" to int'''),
    KeywordEntry(r'''to?''', r'''Safely converts a value, returning null on conversion failure. Custom conversions catch ConversionError, not arbitrary exceptions. A nullable target is allowed.''', r'''تحويل آمن يعيد null عند فشل التحويل؛ يلتقط ConversionError وليس كل الاستثناءات.''', r'''number = "invalid" to? int'''),
    KeywordEntry(r'''class''', r'''Declares a class with an indented member body. Fields can synthesize a constructor; methods, properties and conversion declarations belong in the body.''', r'''تعريف كلاس ذي حقول ودوال وخصائص وتحويلات؛ قد تولّد الحقول بانيًا تلقائيًا.''', r'''class Point:
