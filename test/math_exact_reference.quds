# Generated using independent Python integers and fractions.Fraction.
# Running this Quds suite requires no Python installation.
use quds:math

class _ExactCount:
  var value: int = 0

_expectBig(counter: _ExactCount, actual: BigInt, digits: String):
  counter.value += 1
  expect(actual.toString(), digits)

_expectRational(counter: _ExactCount, actual: BigFraction, top: String, bottom: String):
  counter.value += 1
  expect(actual.numerator.toString(), top)
  expect(actual.denominator.toString(), bottom)
  expect(actual.denominator > BigInt.zero, true)
  expect(actual.numerator.gcd(actual.denominator), BigInt.one)

test "exact arithmetic against frozen independent Quds references":
  counter = _ExactCount()
  _expectBig(counter, bigFactorial(0), "1")
  _expectBig(counter, bigFactorial(1), "1")
  _expectBig(counter, bigFactorial(2), "2")
  _expectBig(counter, bigFactorial(3), "6")
