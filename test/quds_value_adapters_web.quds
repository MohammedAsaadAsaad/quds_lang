use fixtures.quds_value_adapters.helpers as helpers
use fixtures.quds_value_adapters.helpers show report
use fixtures.quds_value_adapters.facade as forwarded

interface Named:
  name: String
interface Aged:
  age: int
class Person implements Named, Aged:
  name: String required
  age: int required
showName(item: Named & Aged) -> String = item.name
text(value: String? = "Quds") -> String = value ?? "empty"
offset(base: int, extra: int = base) -> int = base + extra
count(...items: int) -> int = items.length
optional<T>(value: T? = null) -> T? = value
class Utility:
  static echo<U>(value: U) -> U = value
class Derived extends Utility:
  tag: int = 0
extend String:
  tag<T>(value: T) -> T = value

class DefaultOwner<T>:
  var seed: int = 2
  keep<U>(value: U, first: int = seed, second: int = first) -> U = value
  readonly number(first: int = seed, second: int = first) -> int = first + second
class StaticDefault:
  static choose<U>(value: U, times: int = 1) -> U = value
class ChildDefault extends DefaultOwner<int>:
  tag: int = 0

class DefaultBase:
  readonly number(value: int = 1) -> int = value
class DefaultChild extends DefaultBase:
  readonly number(value: int = 2) -> int = value * 10


main() async:
  saved = text
  print saved()
  print saved(value: null)
  print offset(2)
  print count(1, 2)
  omitted: (value: int? = missing) -> int? = optional
  print omitted()
  print showName(Person(name: "Ada", age: 3))
  print Derived.echo<int>(6)
  print "ab".tag<int>(3)
  integer: (int) -> String = helpers.pick
  print integer(1)
  print helpers.pick("a")
  sample(first: int = 3, second: int = first) -> int = first * 10 + second
  dependent = sample
  print dependent()
  print dependent(first: 4)
  choose(value: Object? = "default") -> Object? = value
  distinguish = choose
  print distinguish()
  print distinguish(value: null)
  print distinguish(value: missing) == missing
  print dependent == sample
  selfDefault(value: Object? = selfDefault) -> int = 1
  selfReference = selfDefault
  print selfReference()
  owner = DefaultOwner<int>()
  first = owner.keep<String>
  print first == owner.keep<String>
  print first("Quds")
  read = owner.number
  print read()
  owner.seed = 5
  print read()
  view: readonly DefaultOwner<int> = owner
  readonlyRead = view.number
  print readonlyRead == view.number
  print readonlyRead()
  inherited = ChildDefault()
  print inherited.number()
  staticValue = StaticDefault.choose<String>
  print staticValue == StaticDefault.choose<String>
  print staticValue("static")
  absent: DefaultOwner<int>? = null
  print absent?.number == null
  available: DefaultOwner<int>? = DefaultOwner<int>()
  nullableValue = available?.number
  print nullableValue!()
  child = DefaultChild()
  base: DefaultBase = child
  fromBase = base.number
  fromChild = child.number
  print fromBase()
  print fromChild()
  provider = helpers.report
  print provider()
  print provider(first: 12)
  print provider == helpers.report
  print provider == report
  print provider == forwarded.report
  copied = helpers.copyValue<int>
  print copied(5)
  print copied(5, other: 8)
  choice = helpers.choose
  print choice()
  print choice(value: null)
  print choice(value: missing) == missing
  asyncValue = helpers.asyncCopy<int>
  print await asyncValue(9)
  print await asyncValue(9, other: 10)
  print helpers.report()
  print helpers.report(first: 12)
  print report(second: 4)
