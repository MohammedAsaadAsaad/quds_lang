#region Sum Functions
sum(a: int, b: int) -> int:
  return a + b

sum(a: String, b: String) -> String:
  return "{a} {b}"

sum(a: List<int>) = a[0] + a[1]
sum(a: List<String>) = "{a[0]} {a[1]}".length * m.pi
#end region




