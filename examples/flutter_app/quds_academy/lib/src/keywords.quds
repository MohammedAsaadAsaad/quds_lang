    KeywordEntry(r'''super''', r'''Accesses the superclass implementation or declares a forwarded initializing parameter.''', r'''الوصول إلى تنفيذ الكلاس الأب أو تمرير معامل تهيئة إلى حقله.''', r'''class Child extends Parent:
