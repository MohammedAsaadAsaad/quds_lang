{
  "name": "quds",
  "displayName": "Quds",
  "description": "Syntax highlighting, formatting, LSP intelligence, and live debugging for Quds (.quds) files.",
  "version": "0.1.0",
  "publisher": "quds-lang",
  "license": "MIT",
  "icon": "icons/quds.png",
  "homepage": "https://github.com/MohammedAsaadAsaad/quds_lang",
  "repository": {
    "type": "git",
    "url": "https://github.com/MohammedAsaadAsaad/quds_lang.git"
  },
  "bugs": {
    "url": "https://github.com/MohammedAsaadAsaad/quds_lang/issues"
  },
  "keywords": ["quds", "dart", "flutter", "language", "lsp", "debugger"],
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": ["Programming Languages", "Formatters", "Linters", "Debuggers"],
    "activationEvents": [
      "onLanguage:quds",
      "onDebugResolve:quds",
      "onDebugInitialConfigurations",
      "onDebugDynamicConfigurations"
    ],
  "main": "./extension.js",
  "contributes": {
    "languages": [
      {
        "id": "quds",
        "aliases": ["Quds", "quds"],
        "extensions": [".quds"],
        "configuration": "./language-configuration.json",
        "icon": {
          "light": "./icons/quds.png",
          "dark": "./icons/quds.png"
        }
      }
    ],
    "grammars": [
      {
        "language": "quds",
        "scopeName": "source.quds",
        "tokenTypes": { "meta.embedded.expression.quds": "other" },
        "path": "./syntaxes/quds.tmLanguage.json"
      }
    ],
    "configurationDefaults": {
      "[quds]": {
        "editor.defaultFormatter": "quds-lang.quds",
        "editor.formatOnSave": true,
        "editor.tabSize": 2,
        "editor.insertSpaces": true,
        "editor.quickSuggestions": { "other": "on", "comments": "off", "strings": "off" },
        "editor.suggestOnTriggerCharacters": true,
        "editor.acceptSuggestionOnCommitCharacter": true,
        "editor.wordBasedSuggestions": "off",
        "editor.snippetSuggestions": "top"
      }
    },
    "configuration": {
      "title": "Quds",
      "properties": {
        "quds.serverCommand": {
          "type": "array",
          "items": { "type": "string" },
          "default": [],
          "markdownDescription": "Command that starts the language server. An empty list uses `dart run bin/quds.dart lsp` when the workspace is the `quds` package, and `quds lsp` otherwise."
        },
        "quds.format.onSave": {
          "type": "boolean",
          "default": true,
          "description": "Automatically format Quds (.quds) files when saving."
        },
        "quds.format.lineWidth": {
          "type": "number",
          "default": 80,
          "minimum": 40,
          "description": "Maximum line width. A one-line condition stays on two lines when joining would pass this width."
        },
        "quds.format.singleLineIf": {
          "type": "boolean",
          "default": true,
          "description": "Put a condition with a single statement on one line. Indent width follows the editor tab size."
        }
      }
    },
    "commands": [
      {
        "command": "quds.restartServer",
        "title": "Quds: Restart Language Server"
      },
      {
        "command": "quds.run",
        "title": "Quds: Run"
      },
      {
        "command": "quds.debug",
        "title": "Quds: Debug"
      },
      {
        "command": "quds.hotReload",
        "title": "Quds: Hot Reload",
        "enablement": "debugType == quds && inDebugMode"
      },
      {
        "command": "quds.hotRestart",
        "title": "Quds: Hot Restart",
        "enablement": "debugType == quds && inDebugMode"
      },
      {
        "command": "quds.profile",
        "title": "Quds: Profile"
      },
      {
        "command": "quds.showDart",
        "title": "Quds: Show Generated Dart",
        "icon": "$(diff)"
      }
    ],
    "breakpoints": [
      {
        "language": "quds"
      }
    ],
    "debuggers": [
      {
        "type": "quds",
        "label": "Quds",
        "languages": ["quds"],
        "configurationAttributes": {
          "launch": {
            "required": ["program"],
            "properties": {
              "program": {
                "type": "string",
                "description": "The .quds file to debug.",
                "default": "${file}"
              },
              "cwd": {
                "type": "string",
                "description": "Working directory of the program.",
                "default": "${fileDirname}"
              }
            }
          }
        },
        "initialConfigurations": [
          {
            "type": "quds",
            "request": "launch",
            "name": "Debug Quds",
            "program": "${file}",
            "cwd": "${fileDirname}"
          }
        ]
      }
    ],
    "keybindings": [
      {
        "command": "quds.debug",
        "key": "f5",
        "when": "editorLangId == quds && !inDebugMode"
      }
    ],
    "menus": {
      "editor/title": [
        {
          "command": "quds.showDart",
          "when": "editorLangId == quds",
          "group": "navigation"
        }
      ],
      "editor/context": [
        {
          "command": "quds.showDart",
          "when": "editorLangId == quds",
          "group": "navigation"
        }
      ]
    }
  }
}
