  learn(context: BuildContext, width: double) -> Widget:
    navigationItems: List<Widget> = []
    for index in 0..<catalog.length:
      lesson = catalog[index]
      if (lesson.titleAr + lesson.titleEn).toLowerCase().contains(query): navigationItems.add(lessonTile(context, index))
    selector = Column(crossAxisAlignment: CrossAxisAlignment.stretch,
    children: [searchBox(context), SizedBox(height: 16.0),
    if navigationItems.isEmpty: emptySearch(context), ...navigationItems])
    if width > 850.0:
      return Row(crossAxisAlignment: CrossAxisAlignment.start,
      children: [SizedBox(width: 245.0, child: selector), SizedBox(width: 28.0),
      Expanded(child: AnimatedSwitcher(duration: motion(context, 220),
      child: lessonContent(context)))])
    onLessonSelected = (value: int?) -> :
      if value != null: openLesson(value)
    return Column(crossAxisAlignment: CrossAxisAlignment.stretch,
    children: [DropdownButtonFormField<int>(initialValue: currentLesson,
    key: ValueKey(currentLesson), isExpanded: true,
    decoration: InputDecoration(labelText: tr("Choose a lesson", "اختر درسًا"),
    border: OutlineInputBorder(borderRadius: BorderRadius.circular(12.0))), items: [for index in 0..<catalog.length: DropdownMenuItem<int>(value: index, child: Text((if (arabic): (catalog[index].titleAr) else: (catalog[index].titleEn)), overflow: TextOverflow.ellipsis))], onChanged: onLessonSelected), SizedBox(height: 24.0), AnimatedSwitcher(duration: motion(context, 220), child: lessonContent(context))])

  chooseCategory(id: String) -> void:
    update = () -> :
      currentCategory = id
      query = ""
      search.clear()
    setState(update)

