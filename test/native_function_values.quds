use fixtures/function_values/api.dart as native
use fixtures/function_values/api.dart show increment, zero, identity

apply(callback: (int) -> int, value: int) -> int:
  return callback(value)

test "native function values preserve required signatures":
  next = increment
  readZero = zero
  twice = native.Counter.twice
  expect(apply(next, 3), 4)
  expect(readZero(), 7)
  expect(twice(6), 12)

test "bound native receivers are evaluated and captured once":
  add = native.makeCounter().add
  expect(native.receiverCount(), 1)
  expect(add(2), 12)
  expect(add(3), 13)
  expect(native.receiverCount(), 1)

test "native generic class substitution survives method values":
  box = native.Box<int>(9)
  read = box.read
  expect(read(), 9)

test "null-aware native method values preserve null":
  maybe: native.Counter? = null
  saved = maybe?.add
  expect(saved, null)

test "optional values preserve native defaults and explicit null":
  saved: ([value: int = 0]) -> int = native.optional
  nullable: ([value: int? = null]) -> int? = native.nullableOptional
  one: (int) -> int = native.optional
  noArgs: () -> int = native.optional
  expect(one(8), 8)
  expect(noArgs(), 5)
  expect(saved(), 5)
  expect(saved(12), 12)
  expect(nullable(), 9)
  expect(nullable(null), null)

test "named function values and bound methods preserve labels":
  selected: (value: int required) -> int = native.named
  mixed: (int, last: int required, middle: int = 0, nullable: int? = null) -> String = native.combine
  counter = native.Counter(10)
  positional = counter.optionalAdd
  named = counter.namedAdd
  expect(selected(value: 6), 6)
  expect(mixed(1, last: 3), "1:7:3:9")
  expect(mixed(1, nullable: null, last: 3), "1:7:3:null")
  expect(positional(), 15)
  reduced: (other: int required) -> int = counter.namedAdd
  expect(reduced(other: 4), 16)
  expect(named(other: 4), 16)
  expect(named(extra: 8, other: 4), 22)

test "native callback metadata retains optional and named parameters":
  expect(native.invokeOptional(native.optional), 8)
  expect(native.invokeNamed(native.named), 4)
  expect(native.invokeCombined(native.combine), "1:7:3:9")

test "function expression and reordered arguments execute once in source order":
  native.resetTrace()
  answer = native.makeNamed()(native.tick("A", 1), last: native.tick("B", 3), middle: native.tick("D", 2))
  expect(answer, "1:2:3:9")
  expect(native.trace(), "CABD")

test "explicit native generic function values retain specialized signatures":
  top = identity<int>
  prefixed = native.identity<String>
  sequence = native.identity<List<int>>
  bounded = native.bounded<int>
  optional = native.genericOptional<int>
  named = native.genericNamed<String>
  expect(top(12), 12)
  expect(sequence([1, 2]), [1, 2])
  expect(prefixed("Quds"), "Quds")
  expect(bounded(4), 4)
  expect(optional(), null)
  expect(optional(5), 5)
  expect(named(value: "typed"), "typed")
  expect(native.invokeNamed(native.genericNamed<int>), 4)

test "explicit generic method values capture receivers and class bounds":
  before = native.receiverCount()
  bound = native.makeCounter().identity<int>
  staticValue = native.Counter.staticIdentity<String>
  selected = native.Box<num>(1).select<int>
  expect(bound(7), 7)
  expect(bound(8), 8)
  expect(native.receiverCount(), before + 1)
  expect(staticValue("static"), "static")
  expect(selected(9), 9)
  absent: native.Counter? = null
  absentMethod = absent?.identity<int>
  expect(absentMethod, null)
  availableReceiver: native.Counter? = native.Counter(2)
  presentMethod = availableReceiver?.identity<int>
  expect(presentMethod!(11), 11)

test "context specializes generic functions and methods with checked bounds":
  top: (int) -> int = identity
  prefixed: (String) -> String = native.identity
  staticValue: (String) -> String = native.Counter.staticIdentity
  before = native.receiverCount()
  bound: (int) -> int = native.makeCounter().identity
  selected: (int) -> int = native.Box<num>(1).select
  fixed: (String) -> num = native.fixedResult
  widenedResult: (int) -> num = native.identity
  expect(top(12), 12)
  expect(prefixed("context"), "context")
  expect(staticValue("static"), "static")
  expect(bound(3), 3)
  expect(bound(4), 4)
  expect(native.receiverCount(), before + 1)
  expect(selected(5), 5)
  expect(fixed("input"), 7)
  expect(widenedResult(21), 21)

test "callback contexts preserve named optional and reordered labels":
  optional: ([value: int?]) -> int? = native.genericOptional
  named: (value: int required) -> int = native.genericNamed
  empty: () -> int? = native.genericAbsent
  reordered: (second: int required, first: int required) -> int = native.genericPair
  expect(optional(), null)
  expect(optional(6), 6)
  expect(named(value: 7), 7)
  expect(empty(), null)
  expect(reordered(first: 1, second: 2), 2)
  expect(native.invokeRequired(native.identity), 8)
  expect(native.invokeNamed(native.genericNamed), 4)

test "contextual nullable methods and Future returns keep their types" async:
  absent: native.Counter? = null
  absentMethod: ((int) -> int)? = absent?.identity
  expect(absentMethod, null)
  receiver: native.Counter? = native.Counter(1)
  availableMethod: ((int) -> int)? = receiver?.identity
  expect(availableMethod!(9), 9)
  future: (int) -> Future<int> = native.genericFuture
  expect(await future(10), 10)
