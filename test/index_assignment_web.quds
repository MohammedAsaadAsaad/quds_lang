main():
  grid = [[1, 2], [3, 4]]
  alias = grid[0]
  grid[0][-1] *= 3
  require alias[1] == 6
  items: Map<int, int> = map:
  items[-1] ??= 7
  require items[-1] == 7
  first = map:
    "a": 1
  maps = [first]
  maps[0] += map:
    "b": 2
  require maps[0]["b"] == 2
  nullable: List<int?> = [null, 4]
  nullable[0] ??= 3
  require nullable[0] == 3
  print "INDEX WEB OK"
