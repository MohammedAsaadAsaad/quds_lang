use fixtures.owner_defaults.provider as api

class Host with api.Label:
  marker: int = 1

class Child extends api.Base:
  taken() -> int:
    saved = read
    return saved()
  same() -> bool:
    saved = read
    return saved == read

main():
  point = api.Point(x: 3)
  scaled = point.scale
  print scaled == point.scale
  print scaled()
  host = Host()
  labeled = host.read
  print labeled == host.read
  print labeled()
  child = Child()
  print child.taken()
  print child.same()
