{
  "comments": {
    "lineComment": "#",
    "blockComment": ["/*", "*/"]
  },
  "brackets": [
    ["(", ")"],
    ["[", "]"],
    ["{", "}"]
  ],
  "autoClosingPairs": [
    { "open": "(", "close": ")" },
    { "open": "[", "close": "]" },
    { "open": "{", "close": "}" },
    { "open": "\"", "close": "\"", "notIn": ["string"] },
    { "open": "'", "close": "'", "notIn": ["string"] }
  ],
  "surroundingPairs": [
    ["(", ")"],
    ["[", "]"],
    ["{", "}"],
    ["\"", "\""],
    ["'", "'"]
  ],
  "onEnterRules": [
    {
      "beforeText": ":\\s*(?:#.*|//.*)?$",
      "action": { "indent": "indent" }
    },
    {
      "beforeText": "^.*$",
      "action": { "indent": "none" }
    }
  ],
  "indentationRules": {
    "increaseIndentPattern": ":\\s*(?:#.*|//.*)?$",
    "decreaseIndentPattern": "^\\s*else\\b"
  },
  "folding": {
    "markers": {
      "start": "^\\s*#\\s*region\\b",
      "end": "^\\s*#\\s*end\\s*region\\b"
    }
  }
}
