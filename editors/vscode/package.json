{
  "name": "quds",
  "displayName": "Quds",
  "description": "Highlight, format, and diagnose Quds (.quds) files.",
  "version": "0.0.1",
  "publisher": "quds-lang",
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": ["Programming Languages", "Formatters", "Linters", "Debuggers"],
  "activationEvents": ["onLanguage:quds", "onDebugResolve:quds"],
  "main": "./extension.js",
  "contributes": {
    "languages": [
      {
        "id": "quds",
        "aliases": ["Quds", "quds"],
        "extensions": [".quds"],
        "configuration": "./language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "quds",
        "scopeName": "source.quds",
        "path": "./syntaxes/quds.tmLanguage.json"
      }
    ],
    "configurationDefaults": {
      "[quds]": {
        "editor.defaultFormatter": "quds-lang.quds",
        "editor.tabSize": 2,
        "editor.insertSpaces": true,
        "editor.quickSuggestions": { "other": "on", "comments": "off", "strings": "off" },
        "editor.suggestOnTriggerCharacters": true,
        "editor.acceptSuggestionOnCommitCharacter": true,
        "editor.wordBasedSuggestions": "off",
        "editor.snippetSuggestions": "top"
      }
    },
    "configuration": {
      "title": "Quds",
      "properties": {
        "quds.serverCommand": {
          "type": "array",
          "items": { "type": "string" },
          "default": [],
          "markdownDescription": "Command that starts the language server. An empty list uses `dart run bin/quds.dart lsp` when the workspace is the `quds_lang` package, and `quds lsp` otherwise."
        }
      }
    },
    "commands": [
      {
        "command": "quds.restartServer",
        "title": "Quds: Restart Language Server"
      },
      {
        "command": "quds.run",
        "title": "Quds: Run"
      },
      {
        "command": "quds.debug",
        "title": "Quds: Debug"
      },
      {
        "command": "quds.profile",
        "title": "Quds: Profile"
      },
      {
        "command": "quds.showDart",
        "title": "Quds: Show Generated Dart",
        "icon": "$(diff)"
      }
    ],
    "debuggers": [
      {
        "type": "quds",
        "label": "Quds",
        "languages": ["quds"],
        "configurationAttributes": {
          "launch": {
            "required": ["program"],
            "properties": {
              "program": {
                "type": "string",
                "description": "The .quds file to debug.",
                "default": "${file}"
              },
              "cwd": {
                "type": "string",
                "description": "Working directory of the program.",
                "default": "${fileDirname}"
              }
            }
          }
        },
        "initialConfigurations": [
          {
            "type": "quds",
            "request": "launch",
            "name": "Debug Quds",
            "program": "${file}",
            "cwd": "${fileDirname}"
          }
        ]
      }
    ],
    "menus": {
      "editor/title": [
        {
          "command": "quds.showDart",
          "when": "editorLangId == quds",
          "group": "navigation"
        }
      ],
      "editor/context": [
        {
          "command": "quds.showDart",
          "when": "editorLangId == quds",
          "group": "navigation"
        }
      ]
    }
  }
}
