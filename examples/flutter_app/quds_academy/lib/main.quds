  workspace(context: BuildContext, width: double) -> Widget:
    if loading:
      return Center(child: Column(mainAxisSize: MainAxisSize.min,
      children: [CircularProgressIndicator(color: brand()),
      SizedBox(height: 20.0), Text(tr("Opening your learning studio…",
      "نجهّز مساحتك للتعلّم…"))]))
    if failed:
      return Center(child: Padding(padding: EdgeInsets.all(30.0),
      child: Column(mainAxisSize: MainAxisSize.min,
      children: [Icon(Icons.cloud_off_rounded, size: 42.0, color: brand()),
      SizedBox(height: 18.0), heading(context,
      tr("We couldn't open your progress", "تعذّر فتح تقدّمك"),
      22.0), SizedBox(height: 12.0), prose(context,
      tr("Your saved data has not been replaced. Retry when local storage is available.", "لم نستبدل بياناتك المحفوظة. أعد المحاولة عندما يتاح التخزين المحلي.")), SizedBox(height: 20.0), FilledButton(onPressed: initialize, child: Text(tr("Try again", "حاول مجددًا")))])))
    padding = (if (width > 700.0): (32.0) else: (18.0))
    available = width - padding * 2.0
    var content: Widget = SizedBox()
    if page == 0: content = overview(context, available)
    if page == 1: content = learn(context, available)
    if page == 2: content = referencePage(context, available)
    if page == 3: content = progressPage(context)
    if page == 4: content = AcademyPlayground(initialCode: playgroundCode, arabic: arabic, dark: dark)
    scrollSection = currentCategory if page == 2 else ""
    return SingleChildScrollView(key: PageStorageKey("page-{page}-{scrollSection}"),
    padding: EdgeInsets.all(padding),
    child: Column(crossAxisAlignment: CrossAxisAlignment.stretch,
    children: [if notice.isNotEmpty: Container(margin: EdgeInsets.only(bottom: 16.0), padding: EdgeInsets.all(16.0), decoration: BoxDecoration(color: Color(0xFFF8EBDD), borderRadius: BorderRadius.circular(12.0)), child: Text(notice, style: TextStyle(color: Color(0xFF895D36), height: 1.7))), AnimatedSwitcher(duration: motion(context, 240), child: KeyedSubtree(key: ValueKey(page), child: content)), SizedBox(height: 20.0)]))

  frame(context: BuildContext) -> Widget:
    layout = (layoutContext: BuildContext, constraints: BoxConstraints) -> :
      wide = constraints.maxWidth >= 1000.0
      mainColumn = Column(children: [header(layoutContext, wide),
      Expanded(child: workspace(layoutContext,
      (if (wide): (constraints.maxWidth - 248.0) else: (constraints.maxWidth))))])
      bottom = NavigationBar(selectedIndex: page,
      onDestinationSelected: selectPage,
      backgroundColor: surface(layoutContext),
      destinations: [NavigationDestination(icon: Icon(Icons.grid_view_outlined),
      selectedIcon: Icon(Icons.grid_view_rounded), label: tr("Home",
      "الرئيسية")), NavigationDestination(icon: Icon(Icons.route_outlined),
      selectedIcon: Icon(Icons.route_rounded), label: tr("Learn",
      "تعلّم")), NavigationDestination(icon: Icon(Icons.auto_stories_outlined),
      selectedIcon: Icon(Icons.auto_stories_rounded), label: tr("Reference",
      "المرجع")), NavigationDestination(icon: Icon(Icons.insights_outlined),
      selectedIcon: Icon(Icons.insights_rounded), label: tr("Progress",
      "تقدّمي")), NavigationDestination(icon: Icon(Icons.terminal_outlined),
      selectedIcon: Icon(Icons.terminal_rounded), label: tr("Playground",
      "المختبر"))])
      return Scaffold(body: SafeArea(child: Row(crossAxisAlignment: CrossAxisAlignment.stretch, children: [if wide: navigation(layoutContext), Expanded(child: mainColumn)])), bottomNavigationBar: (if (wide): (null) else: (bottom)))
    return LayoutBuilder(builder: layout)

  build(context: BuildContext) -> Widget:
    brightness = (if (dark): (Brightness.dark) else: (Brightness.light))
    palette = ColorScheme.fromSeed(seedColor: brand(), brightness: brightness)
    theme = ThemeData(useMaterial3: true, colorScheme: palette,
    brightness: brightness, fontFamily: "Cairo",
    scaffoldBackgroundColor: (if (dark): (Color(0xFF10221E)) else: (Color(0xFFF7F8F4))), visualDensity: VisualDensity.standard)
    return MaterialApp(title: "Quds Academy · أكاديمية قدس",
    debugShowCheckedModeBanner: false,
    locale: Locale((if (arabic): ("ar") else: ("en"))),
    supportedLocales: [Locale("ar"), Locale("en")],
    localizationsDelegates: GlobalMaterialLocalizations.delegates, theme: theme,
    home: Builder(builder: frame))
