  lessonTile(context: BuildContext, index: int) -> Widget:
    lesson = catalog[index]
    done = completed.contains(lesson.id)
    return Padding(padding: EdgeInsets.only(bottom: 9.0),
    child: InteractivePanel(selected: page == 1 and currentLesson == index,
    onTap: () -> openLesson(index),
