    KeywordEntry(r'''type''', r'''Declares a transparent alias, a distinct wrapped type using wraps, or a case hierarchy using sealed type.''', r'''اسم نوع بديل شفاف، أو نوع مميّز باستخدام wraps، أو تسلسل حالات مع sealed type.''', r'''type UserId = int'''),
    KeywordEntry(r'''wraps''', r'''Defines the representation of a distinct extension type. The body accesses its representation as value and may declare requirements.''', r'''تحديد تمثيل نوع مميّز؛ يُتاح التمثيل باسم value داخل جسم النوع ويمكن التحقق منه بـrequire.''', r'''type Positive wraps int:
