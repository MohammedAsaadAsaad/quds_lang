# Same market-day program as examples/catalog.dart.
# Rewritten with trailing if/else, collection helpers, and parallel assignment.
use quds:ext
use quds:core

class Product:
  sku: String required
  cents: int required
  stock: int required
  value() -> int = cents * stock
  low() -> bool = stock < 5


class CartLine:
  units: int required
  cents: int required
  total() -> int = units * cents

class Shift:
  start: int required
  end: int required
  minutes() -> int:
    stack = Stack<int>()
    stack.push(0)
    end.even()
    return end - start if end >= start else end + 1440 - start

sumList(values: List<int>) -> int = values.sum()
minList(values: List<int>) -> int = values.min()!
maxList(values: List<int>) -> int = values.max()!
clampInt(value: int, low: int, high: int) -> int = value.clamp(low, high)

factorial(n: int) -> int:
  var running = 1, cursor = 2
  limit = 12 if n > 12 else n
  while cursor <= limit:
    running *= cursor
    cursor += 1
  return running

fibonacci(n: int) -> int:
  return n if n <= 1
  var previous = 0, current = 1, left = n - 1
  while left > 0:
    previous, current = current, previous + current
    left -= 1
  return current

gcd(a: int, b: int) -> int:
  var left = a.abs, right = b.abs
  while right != 0:
    left, right = right, left % right
  return left

lcm(a: int, b: int) -> int:
  return 0 if a == 0 or b == 0 else a ~/ gcd(a, b) * b

collatzSteps(start: int) -> int:
  return 0 if start < 1
  var value = start, steps = 0
  while value != 1 and steps < 40:
    value = value ~/ 2 if value % 2 == 0 else value * 3 + 1
    steps += 1
  return steps

letterGrade(score: int) -> String:
  return "A" if score >= 90
  return "B" if score >= 80
  return "C" if score >= 70
  return "D" if score >= 60
  return "F"

gpaPoints(score: int) -> int:
  return 4 if score >= 90
  return 3 if score >= 80
  return 2 if score >= 70
  return 1 if score >= 60
  return 0

weighted(a: int, b: int, c: int) -> int = (a * 5 + b * 3 + c * 2) ~/ 10

dayOfYear(month: int, day: int) -> int:
  lengths = [31, 28, 31, 30, 31, 30, 31, 31, 30, 31, 30, 31]
  var cursor = 1, total = day
  while cursor < month and cursor <= 12:
    total += lengths[cursor - 1]
    cursor += 1
  return total

daysInMonth(month: int) -> int:
  return 28 if month == 2
  return 30 if month == 4 or month == 6 or month == 9 or month == 11
  return 31

roundDiv(cents: int, rate: int) -> int:
  base = cents * rate
  whole = base ~/ 100
  return whole + 1 if base % 100 >= 50 else whole

tipOf(cents: int, percent: int) -> int = roundDiv(cents, percent)

splitBill(cents: int, people: int) -> int:
  return cents if people <= 0
  share = cents ~/ people
  return share if cents % people == 0 else share + 1

changeDue(paid: int, owed: int) -> int:
  return 0 if paid <= owed else paid - owed

margin(price: int, cost: int) -> int:
  return 0 if price <= 0 else (price - cost) * 100 ~/ price

markup(cost: int, percent: int) -> int = cost + cost * percent ~/ 100

reorderQty(stock: int, target: int) -> int:
  return 0 if stock >= target else target - stock

rectangleArea(width: int, height: int) -> int:
  return 0 if width < 0 or height < 0 else width * height

rectanglePerimeter(width: int, height: int) -> int = (width + height) * 2

overlapLength(a0: int, a1: int, b0: int, b1: int) -> int:
  start = a0 if a0 > b0 else b0
  end = a1 if a1 < b1 else b1
  return 0 if end <= start else end - start

distanceSquared(x0: int, y0: int, x1: int, y1: int) -> int:
  return dx * dx + dy * dy where dx = x1 - x0, dy = y1 - y0

simpleInterest(principal: int, rate: int, years: int) -> int:
  return principal if years < 0 else principal + principal * rate * years ~/ 100

compoundSteps(principal: int, rate: int, years: int) -> int:
  var balance = principal, left = years
  left = 0 if left < 0
  while left > 0:
    balance += balance * rate ~/ 100
    left -= 1
  return balance

payroll(hours: int, rate: int) -> int:
  return hours * rate if hours <= 40
  return 40 * rate + (hours - 40) * rate * 3 ~/ 2

netPay(gross: int, taxRate: int) -> int:
  tax = gross * taxRate ~/ 100
  return 0 if tax >= gross else gross - tax

countChar(text: String, mark: String) -> int:
  return 0 if mark.length == 0 else text.split(mark).length - 1

shout(text: String) -> String = text.trim().toUpperCase()

wordScore(text: String) -> int:
  return 0 if text.isEmpty else text.trim().length + text.indexOf("a")

boolBit(value: bool) -> int:
  return 1 if value else 0

opensWith(text: String, prefix: String) -> bool = text.startsWith(prefix)

appleTier(units: int, cents: int) -> int:
  return cents * units * 80 ~/ 100 if units >= 24
  return cents * units * 90 ~/ 100 if units >= 12
  return cents * units
breadTier(units: int, cents: int) -> int:
  return cents * units * 85 ~/ 100 if units >= 20
  return cents * units * 95 ~/ 100 if units >= 10
  return cents * units
milkTier(units: int, cents: int) -> int:
  return cents * units * 88 ~/ 100 if units >= 18
  return cents * units * 94 ~/ 100 if units >= 6
  return cents * units
riceTier(units: int, cents: int) -> int:
  return cents * units * 75 ~/ 100 if units >= 30
  return cents * units * 90 ~/ 100 if units >= 10
  return cents * units
oilTier(units: int, cents: int) -> int:
  return cents * units * 82 ~/ 100 if units >= 12
  return cents * units * 92 ~/ 100 if units >= 4
  return cents * units
soapTier(units: int, cents: int) -> int:
  return cents * units * 84 ~/ 100 if units >= 16
  return cents * units * 93 ~/ 100 if units >= 8
  return cents * units
saltTier(units: int, cents: int) -> int:
  return cents * units * 70 ~/ 100 if units >= 40
  return cents * units * 85 ~/ 100 if units >= 20
  return cents * units
honeyTier(units: int, cents: int) -> int:
  return cents * units * 90 ~/ 100 if units >= 8
  return cents * units * 96 ~/ 100 if units >= 4
  return cents * units
teaTier(units: int, cents: int) -> int:
  return cents * units * 86 ~/ 100 if units >= 15
  return cents * units * 94 ~/ 100 if units >= 5
  return cents * units
coffeeTier(units: int, cents: int) -> int:
  return cents * units * 83 ~/ 100 if units >= 10
  return cents * units * 91 ~/ 100 if units >= 4
  return cents * units
flourTier(units: int, cents: int) -> int:
  return cents * units * 78 ~/ 100 if units >= 25
  return cents * units * 90 ~/ 100 if units >= 10
  return cents * units
sugarTier(units: int, cents: int) -> int:
  return cents * units * 80 ~/ 100 if units >= 22
  return cents * units * 92 ~/ 100 if units >= 8
  return cents * units

northShip(grams: int, zone: int) -> int:
  var fee = 25
  if grams >= 2000: fee = 90
  else if grams >= 800: fee = 55
  return fee + zone * 15 if zone > 1 else fee
southShip(grams: int, zone: int) -> int:
  var fee = 20
  if grams >= 1800: fee = 80
  else if grams >= 700: fee = 50
  return fee + zone * 15 if zone > 1 else fee
eastShip(grams: int, zone: int) -> int:
  var fee = 30
  if grams >= 2500: fee = 110
  else if grams >= 1000: fee = 60
  return fee + zone * 15 if zone > 1 else fee
westShip(grams: int, zone: int) -> int:
  var fee = 18
  if grams >= 1500: fee = 70
  else if grams >= 600: fee = 45
  return fee + zone * 15 if zone > 1 else fee
portShip(grams: int, zone: int) -> int:
  var fee = 35
  if grams >= 3000: fee = 140
  else if grams >= 1200: fee = 75
  return fee + zone * 15 if zone > 1 else fee
hillShip(grams: int, zone: int) -> int:
  var fee = 15
  if grams >= 1200: fee = 65
  else if grams >= 500: fee = 40
  return fee + zone * 15 if zone > 1 else fee

rentLate(days: int, due: int) -> int:
  return 0 if days <= 3
  extra = (days - 3) * 15
  cap = due * 20 ~/ 100
  return cap if extra > cap else extra
stallLate(days: int, due: int) -> int:
  return 0 if days <= 2
  extra = (days - 2) * 10
  cap = due * 25 ~/ 100
  return cap if extra > cap else extra
crateLate(days: int, due: int) -> int:
  return 0 if days <= 5
  extra = (days - 5) * 8
  cap = due * 15 ~/ 100
  return cap if extra > cap else extra
coolerLate(days: int, due: int) -> int:
  return 0 if days <= 1
  extra = (days - 1) * 20
  cap = due * 30 ~/ 100
  return cap if extra > cap else extra
licenseLate(days: int, due: int) -> int:
  return 0 if days <= 7
  extra = (days - 7) * 12
  cap = due * 10 ~/ 100
  return cap if extra > cap else extra

clerkBonus(score: int, base: int) -> int:
  return base * 20 ~/ 100 if score >= 95
  return base * 10 ~/ 100 if score >= 80
  return 0
bakerBonus(score: int, base: int) -> int:
  return base * 15 ~/ 100 if score >= 90
  return base * 8 ~/ 100 if score >= 75
  return 0
driverBonus(score: int, base: int) -> int:
  return base * 25 ~/ 100 if score >= 98
  return base * 12 ~/ 100 if score >= 85
  return 0
buyerBonus(score: int, base: int) -> int:
  return base * 18 ~/ 100 if score >= 88
  return base * 9 ~/ 100 if score >= 70
  return 0

ripeSum(values: List<int>) -> int = values.where(v -> v > 5).toList().sum()
heavySum(values: List<int>) -> int = values.where(v -> v > 20).toList().sum()
warmSum(values: List<int>) -> int = values.where(v -> v > 30).toList().sum()
loudSum(values: List<int>) -> int = values.where(v -> v > 2).toList().sum()
tallSum(values: List<int>) -> int = values.where(v -> v > 100).toList().sum()

digitSum(number: int, weight: int) -> int:
  var rest = number.abs, total = 0
  while rest > 0:
    total += (rest % 10) * weight
    rest = rest ~/ 10
  return total

plainDigits(number: int) -> int = digitSum(number, 1)
doubleDigits(number: int) -> int = digitSum(number, 2)
tripleDigits(number: int) -> int = digitSum(number, 3)

rateAppleCrate(units: int) -> int = units * 100 + 0
rateBreadCrate(units: int) -> int = units * 101 + 1
rateMilkCrate(units: int) -> int = units * 102 + 2
rateRiceCrate(units: int) -> int = units * 103 + 3
