use quds:text

_check(ok: bool, msg: String):
  if not ok:
    throw "FAILED: " + msg

main():
  r = TextRange(0, 4)
  _check(sliceText("QudsLang", r) == "Quds", "sliceText")
  _check(isBlankText(" \t\r\n"), "isBlankText")
  _check(beforeText("k=v", "=") == "k", "beforeText")
  part = splitTextOnce("a=b=c", "=")
  _check(part.found and part.before == "a" and part.after == "b=c", "splitTextOnce")
  _check(repeatText("ha", 3, separator: "-") == "ha-ha-ha", "repeatText")
  b = TextBuilder()
  b.append("Hello")
  b.appendLine(" Quds")
  b.appendCodePoint(0x1F600)
  _check(b.build() == "Hello Quds\n😀", "TextBuilder")
  _check(normalizeLineEndings("a\r\nb\rc") == "a\nb\nc", "normalizeLineEndings")
  _check(dedentText("  a\n  b") == "a\nb", "dedentText")

  chars = TextCharacters("قُدس 👨‍👩‍👧‍👦")
  _check(chars.count == 5 and chars.characterAt(0) == "قُ" and chars.characterAt(4) == "👨‍👩‍👧‍👦", "TextCharacters")
  _check(sliceCharacters("قُدس", 0, 2) == "قُد", "sliceCharacters")
  _check(reverseCharacters("قُدس") == "سدقُ", "reverseCharacters")
  _check(normalizeUnicode("e" + String.fromCharCode(0x0301)) == String.fromCharCode(0x00E9), "normalizeUnicode")
  _check(caseFoldText("Straße") == "strasse", "caseFoldText")

  pat = TextPattern.regex("(?<k>[a-z]+)=([0-9]+)")
  hit = findText("id=42", pat)
  _check(hit != null, "findText")
  if let m = hit:
    _check(m.namedGroup("k") == "id" and m.group(2) == "42", "TextMatch groups")
  _check(replaceAllText("a1b22", TextPattern.regex("[0-9]+"), "$1") == "a$1b$1", "replaceAllText literal")
  _check(collapseRepeatedCharacters("قُقُدس") == "قُدس", "collapseRepeatedCharacters")
  reader = TextReader("age=42")
  _check(reader.tryReadText("age=") and reader.readInt() == 42, "TextReader")

  _check(alignText("قُدس", 5, alignment: TextAlignment.end, fill: ".") == "..قُدس", "alignText")
  _check(truncateText("hello world", 8, suffix: "...") == "hello...", "truncateText")
  _check(wrapTextJoined("a b c", TextWrapOptions(3)) == "a b\nc", "wrapTextJoined")
  _check(compareTextNaturally("file2", "file10") < 0, "compareTextNaturally")
  _check(editDistance("kitten", "sitting") == 3, "editDistance")
  _check(unescapeTextLiteral(escapeTextLiteral("a\nb\"c")) == "a\nb\"c", "escape round-trip")
  _check(decodeText(encodeText("قدس 😀", includeBom: true), stripBom: true) == "قدس 😀", "utf8 BOM round-trip")
  _check(decodeText(encodeText("قدس 😀", encoding: TextEncoding.utf16Le), encoding: TextEncoding.utf16Le) == "قدس 😀", "utf16Le round-trip")
  print "TEXT SDK VM WEB OK"
