  codeText(code: String) -> TextSpan:
    names: List<String> = []
    for entry in reference:
      names.add(entry.name)
    spans: List<InlineSpan> = []
    for piece in colorizeCode(code, names):
      var color = Color(0xFFD3EDDF)
      if piece.kind == "keyword": color = Color(0xFFC4ABFF)
      else if piece.kind == "string": color = Color(0xFFF0CE8B)
      else if piece.kind == "number": color = Color(0xFFF5A8BC)
      else if piece.kind == "comment": color = Color(0xFF91ADA7)
      else if piece.kind == "type": color = Color(0xFF7CDBD5)
      else if piece.kind == "function": color = Color(0xFF9AD3FF)
      else if piece.kind == "operator": color = Color(0xFFB5C8EB)
      spans.add(TextSpan(text: piece.text, style: TextStyle(color: color)))
    return TextSpan(children: spans)

