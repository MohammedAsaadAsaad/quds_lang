use dart:math as math deferred
use fixtures.quds_value_adapters.helpers as helpers
use fixtures.quds_value_adapters.helpers show report
use fixtures.quds_value_adapters.facade as forwarded

interface Named:
  name: String
interface Aged:
  age: int
class Person implements Named, Aged:
  name: String required
  age: int required
showName(item: Named & Aged) -> String = item.name
text(value: String? = "Quds") -> String = value ?? "empty"
offset(base: int, extra: int = base) -> int = base + extra
count(...items: int) -> int = items.length
total(first: int, ...rest: int) -> int = first + rest.length
optional<T>(value: T? = null) -> T? = value

class Limited:
  keep<U>(value: U, times: int = 1) -> U = value
  first<U>(...values: U) -> U = values[0]
class Utility:
  static echo<U>(value: U) -> U = value
class Derived extends Utility:
  tag: int = 0
class Fresh:
  readonly read() -> List<int> = [1]
extend String:
  tag<T>(value: T) -> T = value

test "default omission stays distinct from explicit null":
  saved = text
  expect(saved(), "Quds")
  expect(saved(value: null), "empty")
  expect(saved(value: "Ada"), "Ada")
  shifted = offset
  expect(shifted(2), 4)
  expect(shifted(2, extra: 5), 7)

test "variadic values pack arguments and spreads":
  saved = count
  expect(saved(), 0)
  expect(saved(1, 2, 3), 3)
  numbers = [4, 5]
  expect(saved(...numbers), 2)
  summed = total
  expect(summed(7), 7)
  expect(summed(7, 1, 1), 9)

test "generic defaults intersection methods extensions and imports":
  omitted: (value: int? = missing) -> int? = optional
  explicit = optional<int>
  expect(explicit == omitted, true)
  expect(omitted(), null)
  expect(omitted(value: 4), 4)
  person = Person(name: "Ada", age: 3)
  named = showName
  expect(named(person), "Ada")
  kept = Limited().keep<int>
  expect(kept(8), 8)
  expect(kept(8, times: 2), 8)
  head = Limited().first<String>
  expect(head("a", "b"), "a")
  staticValue = Derived.echo<int>
  expect(staticValue(6), 6)
  tagged = "ab".tag<int>
  expect(tagged(3), 3)
  integer: (int) -> String = helpers.pick
  expect(integer(1), "integer")
  expect(helpers.pick("a"), "text")

test "a readonly method value guards its result":
  view: readonly Fresh = Fresh()
  saved = view.read
  expect(saved()[0], 1)

test "deferred libraries load through their prefix" async:
  await math.loadLibrary()
  expect(math.min(1, 2), 1)

class DefaultTrace:
  var calls: int = 0
  nextValue() -> int:
    calls += 1
    return calls

test "defaults resolve once before dependent defaults":
  trace = DefaultTrace()
  sample(first: int = trace.nextValue(), second: int = first) -> int = first * 10 + second
  saved = sample
  expect(saved == sample, true)
  expect(trace.calls, 0)
  expect(saved(), 11)
  expect(trace.calls, 1)
  expect(saved(first: 4), 44)
  expect(trace.calls, 1)
  expect(saved(), 22)
  expect(trace.calls, 2)

test "explicit missing is supplied rather than omitted":
  choose(value: Object? = "default") -> Object? = value
  saved = choose
  expect(saved(), "default")
  expect(saved(value: null), null)
  expect(saved(value: missing), missing)

test "supplied effects precede defaults":
  trace = DefaultTrace()
  compute(first: int = trace.nextValue(), second: int = first) -> int = first * 10 + second
  saved = compute
  expect(saved(second: trace.nextValue()), 21)
  expect(trace.calls, 2)
  expect(saved == compute, true)

test "a failing default prevents entering the body":
  trace = DefaultTrace()
  failValue() -> int:
    throw "default failed"
  perform(value: int = failValue()) -> int:
    trace.nextValue()
    return value
  saved = perform
  try:
    saved()
  catch problem:
    expect(problem, "default failed")
  expect(trace.calls, 0)
  expect(saved(value: 7), 7)
  expect(trace.calls, 1)

selfDefault(value: Object? = selfDefault) -> int = 1

test "a default may store its own function reference":
  saved = selfDefault
  expect(saved(), 1)

class DefaultOwner<T>:
  var seed: int = 2
  keep<U>(value: U, first: int = seed, second: int = first) -> U = value
  readonly number(first: int = seed, second: int = first) -> int = first + second
class StaticDefault:
  static choose<U>(value: U, times: int = 1) -> U = value
class ChildDefault extends DefaultOwner<int>:
  tag: int = 0

test "default methods retain identity and live receiver fields":
  owner = DefaultOwner<int>()
  first = owner.keep<String>
  second = owner.keep<String>
  expect(first == second, true)
  expect(first("Quds"), "Quds")
  read = owner.number
  expect(read(), 4)
  owner.seed = 5
  expect(read(), 10)
  expect(read(first: 3), 6)
  other = DefaultOwner<int>()
  expect(read == other.number, false)
  inherited = ChildDefault()
  expect(inherited.number == inherited.number, true)
  expect(inherited.number(), 4)
  explicit = StaticDefault.choose<String>
  expect(explicit == StaticDefault.choose<String>, true)
  expect(explicit("static"), "static")

test "default readonly method bridges retain identity":
  owner = DefaultOwner<int>()
  view: readonly DefaultOwner<int> = owner
  first = view.number
  expect(first == view.number, true)
  expect(first(), 4)
  owner.seed = 6
  expect(first(), 12)

makeDefault(trace: DefaultTrace) -> DefaultOwner<int>:
  trace.nextValue()
  return DefaultOwner<int>()

test "default bridge captures nullable receivers once":
  trace = DefaultTrace()
  saved = makeDefault(trace).number
  expect(trace.calls, 1)
  expect(saved(), 4)
  expect(saved(), 4)
  expect(trace.calls, 1)
  absent: DefaultOwner<int>? = null
  missingMethod = absent?.number
  expect(missingMethod, null)
  owner: DefaultOwner<int>? = DefaultOwner<int>()
  nullableValue = owner?.number
  expect(nullableValue!(), 4)
  expect(nullableValue == owner?.number, true)

class DefaultBase:
  readonly number(value: int = 1) -> int = value
class DefaultChild extends DefaultBase:
  readonly number(value: int = 2) -> int = value * 10

test "defaults follow the selected owner while the body dispatches virtually":
  child = DefaultChild()
  base: DefaultBase = child
  fromBase = base.number
  fromChild = child.number
  expect(fromBase(), 10)
  expect(fromChild(), 20)
  expect(fromBase(value: 3), 30)
  expect(fromBase == base.number, true)

interface DefaultContract:
  readonly number(value: int = 3) -> int = value
class ContractDefault implements DefaultContract:
  readonly number(value: int = 4) -> int = value * 10

test "interface defaults keep their static contract":
  owner = ContractDefault()
  face: DefaultContract = owner
  fromInterface = face.number
  fromConcrete = owner.number
  expect(fromInterface(), 30)
  expect(fromConcrete(), 40)

test "imported default references run in their provider scope":
  first = helpers.report
  expect(first(), "7:9")
  expect(first(first: 12), "12:12")
  expect(first(second: 4), "7:4")
  expect(first == helpers.report, true)
  expect(first == report, true)
  expect(first == forwarded.report, true)
  copied = helpers.copyValue<int>
  inferred: (value: int, other: int = missing) -> int = helpers.copyValue
  expect(copied(5), 5)
  expect(copied(5, other: 8), 8)
  expect(copied == inferred, true)
  choice = helpers.choose
  expect(choice(), "default")
  expect(choice(value: null), null)
  expect(choice(value: missing), missing)

test "imported async defaults keep Future signatures" async:
  saved = helpers.asyncCopy<int>
  expect(saved == helpers.asyncCopy<int>, true)
  expect(await saved(9), 9)
  expect(await saved(9, other: 10), 10)

test "direct imported calls keep provider defaults and source argument order":
  expect(helpers.report(), "7:9")
  expect(helpers.report(first: 12), "12:12")
  expect(report(second: 4), "7:4")
  trace = DefaultTrace()
  expect(helpers.report(second: trace.nextValue(), first: trace.nextValue()), "2:1")
  expect(trace.calls, 2)

test "imported method bridges own defaults and retain receiver identity":
  owner = helpers.DefaultBox<int>(stored: 8)
  read = owner.read
  expect(read == owner.read, true)
  expect(read(), 11)
  expect(read(first: 12), 24)
  take = owner.take<String>
  expect(take == owner.take<String>, true)
  expect(take("value"), "value")
  expect(read(), 12)
  copied = owner.copy
  expect(copied(), 8)
  staticValue = helpers.DefaultBox.number
  expect(staticValue(), 7)
  expect(staticValue == helpers.DefaultBox.number, true)
  expect(owner.read(), 12)
  expect(owner.take<String>("direct"), "direct")
  expect(read(), 13)

test "imported readonly and nullable method references retain defaults":
  owner = helpers.DefaultBox<int>(stored: 8)
  view: readonly helpers.DefaultBox<int> = owner
  read = view.read
  expect(read == view.read, true)
  expect(read(), 11)
  absent: helpers.DefaultBox<int>? = null
  expect(absent?.read, null)
  available: helpers.DefaultBox<int>? = owner
  nullableRead = available?.read
  expect(nullableRead!(), 11)
  expect(nullableRead == available?.read, true)

class ImportedDefaultChild extends helpers.DefaultBox<int>:
  readonly read(first: int = 20, second: int = first) -> int = first + second

makeImported(trace: DefaultTrace) -> helpers.DefaultBox<int>:
  trace.nextValue()
  return helpers.DefaultBox<int>(stored: 8)

test "imported method bridge owners preserve inheritance and receiver evaluation":
  trace = DefaultTrace()
  read = makeImported(trace).read
  expect(trace.calls, 1)
  expect(read(), 11)
  expect(read(), 11)
  expect(trace.calls, 1)
  expect(makeImported(trace).take<String>("direct"), "direct")
  expect(trace.calls, 2)
  expect(helpers.DefaultBox<int>(stored: 8).read(), 11)
  child = ImportedDefaultChild(stored: 8)
  base: helpers.DefaultBox<int> = child
  fromBase = base.read
  fromChild = child.read
  expect(fromBase(), 11)
  expect(fromChild(), 40)
  expect(fromBase == base.read, true)
  inheritedStatic = ImportedDefaultChild.number
  expect(inheritedStatic(), 7)
  expect(ImportedDefaultChild.number(), 7)

test "null-aware provider calls skip supplied arguments and defaults":
  trace = DefaultTrace()
  absent: helpers.DefaultBox<int>? = null
  outcome = absent?.read(first: trace.nextValue())
  expect(outcome, null)
  expect(trace.calls, 0)
  available: helpers.DefaultBox<int>? = helpers.DefaultBox<int>(stored: 8)
  value = available?.read()
  expect(value, 11)

test "interface bridges retain provider defaults and stable equality":
  owner = helpers.ReadImplementation()
  face: helpers.ReadContract = owner
  saved = face.read
  expect(saved(), 70)
  expect(saved == face.read, true)
  expect(owner.read(), 40)
  expect(face.read(), 70)
  view: readonly helpers.ReadContract = owner
  readonlyValue = view.read
  expect(readonlyValue(), 70)
  expect(readonlyValue == view.read, true)
  child: helpers.ChildRead = helpers.ChildReadImplementation()
  inherited = child.read
  expect(inherited(), 70)
  expect(inherited == child.read, true)

test "generic interface method bridges keep their binders":
  face: helpers.CopyContract = helpers.CopyImplementation()
  explicit = face.copy<int>
  contextual: (value: int, other: int = missing) -> int = face.copy
  expect(explicit(8), 8)
  expect(explicit(8, other: 9), 9)
  expect(explicit == contextual, true)

interface SecondReadContract:
  readonly read(value: int = 5) -> int = value
class MultiContractImplementation implements helpers.ReadContract, SecondReadContract:
  readonly read(value: int = 1) -> int = value * 10

test "different interface contracts keep different defaults on one receiver":
  owner = MultiContractImplementation()
  first: helpers.ReadContract = owner
  second: SecondReadContract = owner
  fromFirst = first.read
  fromSecond = second.read
  expect(fromFirst(), 70)
  expect(fromSecond(), 50)
  expect(owner.read(), 10)
  expect(fromFirst == first.read, true)
  expect(fromSecond == second.read, true)
  expect(fromFirst == fromSecond, false)

test "interface defaults observe live getters and supplied values":
  owner = helpers.LiveImplementation()
  face: helpers.LiveContract = owner
  saved = face.read
  expect(saved(), 12)
  owner.seed = 4
  expect(saved(), 13)
  expect(saved(second: 2), 6)
  view: readonly helpers.LiveContract = owner
  readonlyValue = view.read
  expect(readonlyValue(), 13)
  expect(readonlyValue == view.read, true)

test "interface bridges distinguish omission null missing and nullable calls":
  face: helpers.MissingContract = helpers.MissingImplementation()
  saved = face.choose
  expect(saved(), "default")
  expect(saved(value: null), null)
  expect(saved(value: missing), missing)
  absent: helpers.ReadContract? = null
  expect(absent?.read, null)
  trace = DefaultTrace()
  outcome = absent?.read(value: trace.nextValue())
  expect(outcome, null)
  expect(trace.calls, 0)

test "a failing interface default prevents target body execution":
  owner = helpers.ThrowImplementation()
  face: helpers.ThrowContract = owner
  saved = face.run
  expect(saved, throwsA(equals("interface default failed")))
  expect(owner.entered, 0)
  expect(saved(value: 8), 8)
  expect(owner.entered, 1)

interface GenericDefaultContract<T>:
  readonly read(value: T? = null) -> T? = value
class GenericDefaultImplementation<X> implements GenericDefaultContract<X>:
  readonly read(value: X? = null) -> X? = value

test "generic declaring interfaces retain their existing value path":
  face: GenericDefaultContract<int> = GenericDefaultImplementation<int>()
  saved = face.read
  expect(saved(), null)
  expect(saved(value: 8), 8)

test "interface resolver packets preserve provider alias names":
  face: helpers.AliasContract = helpers.AliasImplementation()
  saved = face.read
  expect(saved(), 8)
  expect(saved == face.read, true)
