use quds:core::typed

readonlyFloats(values: Float64List) -> readonly Float64List = values
capturedReadonly(values: Float64List) -> () -> readonly Float64List:
  borrowed: readonly Float64List = values
  return capture(borrowed) -> borrowed

readonlyBytes(values: ByteData) -> readonly ByteData = values
readonlyBase(values: TypedData) -> readonly TypedData = values
readonlyBuffer(values: ByteBuffer) -> readonly ByteBuffer = values
probeFloats(values: readonly Float64List, probe: (dynamic) -> bool) -> bool = probe(values)

main():
  values = Float64List.fromList([1.0, 2.0, 3.0])
  view = Float64List.sublistView(values, 1)
  view[0] = 4.0
  require values[1] == 4.0
  require values[-1] == 3.0
  copy = Float64List.fromList(values)
  copy[0] = 5.0
  require values[0] == 1.0
  borrowed = readonlyFloats(values)
  values[0] = 6.0
  require borrowed[0] == 6.0
  bytes = Uint8List(8)
  data = ByteData.view(bytes.buffer)
  data.setFloat64(0, 1.5, Endian.little)
  require bytes[7] == 63
  require data.getFloat64(0, Endian.little) == 1.5
  small = Int8List(1)
  small[0] = 130
  require small[0] == -126
  single = Float32List(1)
  single[0] = 0.1
  require single[0] == 0.10000000149011612
  print "TYPED STORAGE OK"
