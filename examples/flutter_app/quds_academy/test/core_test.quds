use ^.lib.src.code_colors
use ^.lib.src.reference_design
use ^.lib.src.progress
use ^.lib.src.catalog
use ^.lib.src.keywords

test "sqlite_plus executes SQL from Quds and preserves Unicode and bound values" async:
  store = await openProgress(null)
  await store.complete("hello")
  await store.complete("hello")
  await store.complete("قدس'; DROP TABLE progress; --")
  await store.setSetting("locale", "ar")
  ids = await store.completedIds()
  expect(ids.length, 2)
  expect(ids.contains("hello"), true)
  expect(ids.contains("قدس'; DROP TABLE progress; --"), true)
  expect(await store.setting("locale"), "ar")
  expect(await store.setting("unknown"), null)
  bytes = store.image()
  await store.close()
  reopened = await openProgress(bytes)
  expect((await reopened.completedIds()).length, 2)
  expect(await reopened.setting("locale"), "ar")
  await reopened.reset()
  expect((await reopened.completedIds()).length, 0)
  expect(await reopened.setting("locale"), "ar")
  await reopened.close()

test "every runnable lesson matches its displayed output" async:
  for lesson in lessons():
    expect(await runLesson(lesson.id), lesson.output, reason: lesson.id)
    expect(lesson.titleAr.isNotEmpty and lesson.bodyAr.isNotEmpty, true)
    expect(lesson.correct >= 0 and lesson.correct < lesson.optionsEn.length,
    true)
    expect(lesson.optionsAr.length, lesson.optionsEn.length)
  expect(await databaseDemo(), "42")

test "offline keyword reference has complete bilingual coverage":
  entries = keywordEntries()
  expect(entries.length, 111)
  for entry in entries:
    expect(entry.english.isNotEmpty and entry.arabic.isNotEmpty and entry.example.isNotEmpty, true)

test "categories cover every word exactly once":
  seen: List<String> = []
  categories = keywordCategories()
  expect(categories.length, 12)
  for category in categories:
    expect(category.english.isNotEmpty and category.arabic.isNotEmpty, true)
    expect(category.purposeEn.isNotEmpty and category.purposeAr.isNotEmpty, true)
    for word in category.words:
      expect(seen.contains(word), false, reason: word)
      seen.add(word)
      expect(keywordCategory(word), category.id)
  expect(seen.length, 111)
  for entry in keywordEntries():
    expect(seen.contains(entry.name), true)

test "colored examples preserve exact source and lexical distinctions":
  names: List<String> = []
  for entry in keywordEntries():
    names.add(entry.name)
  for entry in keywordEntries():
    var restored = ""
    for piece in colorizeCode(entry.example, names):
      restored += piece.text
    expect(restored, entry.example, reason: entry.name)
  for lesson in lessons():
    var restoredLesson = ""
    for piece in colorizeCode(lesson.code, names):
      restoredLesson += piece.text
    expect(restoredLesson, lesson.code, reason: lesson.id)
  sample = r'''# if ignored
var اسم = "if {name}" # comment
value = 12.5
raw = r"no\nescape"
/* nested /* if */ comment */
print item to? int
'''
  pieces = colorizeCode(sample, names)
  expect(pieces[0].kind, "comment")
  var restored = ""
  var safeCast = false
  for piece in pieces:
    restored += piece.text
    if piece.text == "to?":
      expect(piece.kind, "keyword")
      safeCast = true
    if piece.text == "12.5": expect(piece.kind, "number")
    if piece.text == "اسم": expect(piece.kind, "plain")
  expect(restored, sample)
  expect(safeCast, true)
  for incomplete in ["", "'unfinished", "/* incomplete", "r", "\\", "1..3"]:
    var joined = ""
    for piece in colorizeCode(incomplete, names):
      joined += piece.text
    expect(joined, incomplete)
  for number in ["0xFF", "1_000", "12.5", "1e-3", "2.0E+10"]:
    colored = colorizeCode(number, names)
    expect(colored.length, 1)
    expect(colored[0].text, number)
    expect(colored[0].kind, "number")
  literal = r'''r"""if {x}
# still a string"""'''
  rawPieces = colorizeCode(literal, names)
  expect(rawPieces.length, 1)
  expect(rawPieces[0].kind, "string")
  block = "/* outer /* inner */ done */"
  commentPieces = colorizeCode(block, names)
  expect(commentPieces.length, 1)
  expect(commentPieces[0].kind, "comment")
  rangePieces = colorizeCode("1..3", names)
  expect(rangePieces[0].text, "1")
  expect(rangePieces[1].kind, "operator")
  expect(rangePieces[2].kind, "operator")
  expect(rangePieces[3].text, "3")
