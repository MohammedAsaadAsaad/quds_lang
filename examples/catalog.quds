  product = Product(sku: "A1", cents: 250, stock: 4)
  total += product.value()
  if product.low():
    total += 1
  line = CartLine(units: 3, cents: 40)
  total += line.total()
  shift = Shift(start: 22 * 60, end: 6 * 60)
  total += shift.minutes()
  return total

main():
  product = Product(sku: "A1", cents: 250, stock: 4)
  shift = Shift(start: 22 * 60, end: 6 * 60)
  print "day"
  print digest()
  print product.value()
  print product.low()
  print shift.minutes()
  print letterGrade(92)
  print sumList([4, 5, 6])



