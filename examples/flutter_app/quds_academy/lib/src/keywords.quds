    KeywordEntry(r'''protected''', r'''Allows access from the declaring library and subtypes. Quds checks access; Dart runtime enforcement is not provided.''', r'''وصول للمكتبة المعرّفة والأنواع الفرعية؛ يفحصه مترجم قدس وليس آلة Dart الافتراضية.''', r'''class Base:
  protected count: int = 0'''),
    KeywordEntry(r'''readonly''', r'''Restricts mutation through a reference or method. It does not freeze the object or other aliases. Nested writes and mutating calls are rejected.''', r'''منع التعديل من خلال مرجع أو دالة، بما يشمل الكتابة المتداخلة؛ لا يجمّد الكائن أو مراجعه الأخرى.''', r'''read(items: readonly List<int>) -> int:
  return items.length'''),
    KeywordEntry(r'''required''', r'''Marks a required field or a required named-only parameter. Plain function parameters are dual positional/named parameters.''', r'''حقل مطلوب أو معامل مسمى فقط ومطلوب؛ المعامل العادي يقبل التمرير بالترتيب أو بالاسم.''', r'''greet(name: String required):
