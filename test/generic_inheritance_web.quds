class Base<T>:
  static var calls: int = 0
  private var stored: T required
  count: int = 2
  read() -> T = stored
class Middle<V> extends Base<Map<String, V>>:
  tag: String required
class Derived<U> extends Middle<List<U>>:
  ownRead() -> Map<String, List<U>> = stored
class Parent<T>:
  value: T required
class ExplicitChild<U> extends Parent<List<U>>:
  init(super.value):
    require value.length >= 0
class GeneratedParent<T>:
  value: T required
  init(this.value):
    require value == value
class GeneratedChild<U> extends GeneratedParent<List<U>>:
  tag: String required
main():
  var trace = ""
  tag() -> String:
    trace += "tag "
    return "nested"
  values() -> Map<String, List<int>>:
    trace += "values "
    return map:
      "x": [31]
  value = Derived<int>(tag: tag(), stored: values())
  require trace == "tag values "
  require value.read()["x"]![0] == 31
  require value.ownRead()["x"]![0] == 31
  replacement = map:
    "x": [32]
  value.stored = replacement
  require value.read()["x"]![0] == 32
  require value.count == 2
  require ExplicitChild<int>([33]).value[0] == 33
  generated = GeneratedChild<int>(value: [34], tag: "generated")
  require generated.value[0] == 34
  require generated.tag == "generated"
  print "GENERIC INHERITANCE OK"
