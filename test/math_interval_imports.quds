use quds:math::scalar as scalar
use quds:math::interval::outward as spans
use quds:math as whole show RealInterval, realInterval

_passSpan(input: whole.RealInterval) -> spans.RealInterval = input

test "section imports expose binary neighbors and extended intervals":
  expect(scalar.nextUp(1.0), 1.0000000000000002)
  expect(scalar.nextDown(1.0), 0.9999999999999999)
  expect(scalar.ulp(0.0), 5.0e-324)
  a = spans.realInterval(0.1, 0.1)
  b = spans.realInterval(0.2, 0.2)
  expect((a + b).contains(0.3), true)
  expect(spans.outwardAdd(spans.outwardPoint(1.0), spans.outwardPoint(2.0)).low < 3.0, true)
  expect(_passSpan(whole.realInterval(1.0, 2.0)).contains(1.5), true)
