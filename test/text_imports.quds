use quds:text::types show TextRange, TextBoundaryPolicy
use quds:text::builder show TextBuilder
use quds:text::split as split
use quds:text::compose as compose
use quds:text::lines as lines
use quds:text::inspect as inspect
use quds:text::slice as slice
use quds:ext

test "selective section imports, prefixes, show, and quds:ext coexistence":
  assert TextBoundaryPolicy.reject != TextBoundaryPolicy.next
  r = TextRange(0, 4)
  assert slice.sliceText("QudsLang", r) == "Quds"

  b = TextBuilder()
  b.append("Hello")
  b.appendLine(" Quds")
  b.appendJoined(["a", "b", "c"], separator: ", ")
  assert b.build() == "Hello Quds\na, b, c"

  part = split.splitTextOnce("name=a=b", "=")
  assert part.before == "name"
  assert part.after == "a=b"
  assert part.found

  assert compose.repeatText("some", 3, separator: "-") == "some-some-some"
  assert lines.normalizeLineEndings("x\r\ny", ending: lines.TextLineEnding.lf) == "x\ny"
  assert inspect.isBlankText("  \t ")
  assert [10, 20, 30].second() == 20
