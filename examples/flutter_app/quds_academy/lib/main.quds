use package:flutter.material
use package:flutter/services.dart
use package:flutter_localizations/flutter_localizations.dart
use package:quds_academy/platform/storage.dart
use package:quds_academy/platform/playground.dart
use package:quds_academy/platform/rule_examples.dart
use dart:typed_data
use src.catalog
use src.keywords
use src.progress
use src.code_colors
use src.reference_design



brand() -> Color = Color(0xFF147D64)

night() -> Color = Color(0xFF102C29)

main():
  runApp(Academy())

ink(context: BuildContext) -> Color:
  return (if (Theme.of(context).brightness == Brightness.dark): (Color(0xFFEAF4EF)) else: (Color(0xFF182D29)))

muted(context: BuildContext) -> Color:
  return (if (Theme.of(context).brightness == Brightness.dark): (Color(0xFFA4BBB1)) else: (Color(0xFF73817B)))

surface(context: BuildContext) -> Color:
  return (if (Theme.of(context).brightness == Brightness.dark): (Color(0xFF162B27)) else: (Colors.white))

lineColor(context: BuildContext) -> Color:
  return (if (Theme.of(context).brightness == Brightness.dark): (Color(0xFF2D443C)) else: (Color(0xFFE5EBE6)))

motion(context: BuildContext, milliseconds: int) -> Duration:
  return (if (MediaQuery.disableAnimationsOf(context)): (Duration.zero) else: (Duration(milliseconds: milliseconds)))

heading(context: BuildContext, text: String, size: double) -> Widget:
  return Text(text, style: TextStyle(fontSize: size,
  fontWeight: FontWeight.w700, height: 1.4, letterSpacing: -0.7,
  color: ink(context)))

prose(context: BuildContext, text: String) -> Widget:
  return Text(text, style: TextStyle(fontSize: 14.0, height: 1.9,
  color: muted(context)))

panel(context: BuildContext, child: Widget) -> Widget:
  return Container(padding: EdgeInsets.all(24.0),
  decoration: BoxDecoration(color: surface(context),
  borderRadius: BorderRadius.circular(22.0),
  border: Border.all(color: lineColor(context))), child: child)

trackIcon(index: int) -> IconData:
  icons = [Icons.terminal_rounded, Icons.alt_route_rounded,
  Icons.view_in_ar_rounded, Icons.rocket_launch_rounded]
  return icons[index]

class Entrance extends StatelessWidget:
  child: Widget required
  order: int = 0
  build(context: BuildContext) -> Widget:
    return TweenAnimationBuilder<double>(tween: Tween<double>(begin: 0.0,
    end: 1.0), duration: motion(context,
    420 + order * 70), curve: Curves.easeOutCubic, child: child, builder: (animationContext: BuildContext, amount: double, content: Widget?) -> Opacity(opacity: amount, child: Transform.translate(offset: Offset(0.0, (1.0 - amount) * 14.0), child: content)))

class InteractivePanel extends StatefulWidget:
  child: Widget required
  onTap: () -> void required
  selected: bool = false
  createState() -> State<InteractivePanel> = InteractivePanelState()

class InteractivePanelState extends State<InteractivePanel>:
  var active: bool = false
  hover(value: bool) -> void:
    change1 = () -> :
      active = value
    setState(change1)
  build(context: BuildContext) -> Widget:
    border = (if (widget.selected or active): (brand()) else: (lineColor(context)))
    built = AnimatedScale:
      scale: (if (active): (1.012) else: (1.0))
      duration: motion(context, 170)
      child: AnimatedContainer:
        duration: motion(context, 180)
        decoration: BoxDecoration(color: surface(context),
        borderRadius: BorderRadius.circular(20.0),
        border: Border.all(color: border, width: 1.0))
        child: Material:
          color: Colors.transparent
          child: InkWell:
            onTap: widget.onTap
            onHover: hover
            onFocusChange: hover
            borderRadius: BorderRadius.circular(20.0)
            child: Padding(padding: EdgeInsets.all(20.0), child: widget.child)

    return built

class Academy extends StatefulWidget:
  storage: AcademyStorage? = null
  createState() -> State<Academy> = AcademyState()

class AcademyState extends State<Academy>:
  var arabic: bool = true
  var dark: bool = false
  var loading: bool = true
  var failed: bool = false
  var saving: bool = false
  var running: bool = false
  var confirmReset: bool = false
  var page: int = 0
  var currentLesson: int = 0
  var currentKeyword: int = 0
  var currentCategory: String = ""
  var choice: int = -1
  var query: String = ""
  var output: String = ""
  var notice: String = ""
  var playgroundCode: String = ""
  var completed: List<String> = []
  var store: ProgressStore? = null
  var storage: AcademyStorage? = null
  catalog: List<Lesson> = lessons()
  reference: List<KeywordEntry> = keywordEntries()
  search: TextEditingController = TextEditingController()

  tr(english: String, translated: String) -> String:
    return (if (arabic): (translated) else: (english))

  initState() -> void:
    super.initState()
    initialize()

  initialize() async -> void:
    change2 = () -> :
      loading = true
      failed = false
    setState(change2)
    try:
      backend = widget.storage ?? await openAcademyStorage()
      bytes: Uint8List? = await backend.load()
      opened = await openProgress(bytes)
      ids = await opened.completedIds()
      language = await opened.setting("locale")
      appearance = await opened.setting("theme")
      if not mounted:
        await opened.close()
        return
      change3 = () -> :
        storage = backend
        store = opened
        completed = ids
        arabic = language != "en"
        dark = appearance == "dark"
        loading = false
      setState(change3)
    catch error:
      if not mounted: return
      change4 = () -> :
        loading = false
        failed = true
      setState(change4)

  dispose() -> void:
    search.dispose()
    if store != null: store!.close()
    super.dispose()

  selectPage(index: int) -> void:
    search.clear()
    change5 = () -> :
      page = index
      query = ""
      confirmReset = false
      notice = ""
    setState(change5)

  updateSearch(value: String) -> void:
    change6 = () -> :
      query = value.trim().toLowerCase()
    setState(change6)

  openLesson(index: int) -> void:
    change7 = () -> :
      currentLesson = index
      page = 1
      choice = -1
      output = ""
      notice = ""
    setState(change7)

  openInPlayground(code: String) -> void:
    change = () -> :
      playgroundCode = code
      page = 4
      notice = ""
    setState(change)

  switchLanguage() async -> void:
    if saving or store == null: return
    change8 = () -> :
      saving = true
    setState(change8)
    try:
      await store!.setSetting("locale", (if (arabic): ("en") else: ("ar")))
      await storage!.save(store!.image())
      if not mounted: return
      change9 = () -> :
        arabic = not arabic
      setState(change9)
    catch error:
      if mounted:
        change10 = () -> :
          notice = tr("Could not save your preference. Please try again.",
          "تعذّر حفظ التفضيل. حاول مرة أخرى.")
        setState(change10)
    finally:
      if mounted:
        change11 = () -> :
          saving = false
        setState(change11)

  switchTheme() async -> void:
    if saving or store == null: return
    change12 = () -> :
      saving = true
    setState(change12)
    try:
      await store!.setSetting("theme", (if (dark): ("light") else: ("dark")))
      await storage!.save(store!.image())
      if not mounted: return
      change13 = () -> :
        dark = not dark
      setState(change13)
    catch error:
      if mounted:
        change14 = () -> :
          notice = tr("Could not save your preference. Please try again.",
          "تعذّر حفظ التفضيل. حاول مرة أخرى.")
        setState(change14)
    finally:
      if mounted:
        change15 = () -> :
          saving = false
        setState(change15)

  runCurrent() async -> void:
    if running: return
    id = catalog[currentLesson].id
    change16 = () -> :
      running = true
    setState(change16)
    try:
      value = await runLesson(id)
      if not mounted: return
      if catalog[currentLesson].id == id:
        change17 = () -> :
          output = value
        setState(change17)
    catch error:
      if mounted:
        change18 = () -> :
          notice = tr("The example could not run. Try again.",
          "تعذّر تشغيل المثال. حاول مجددًا.")
        setState(change18)
    finally:
      if mounted:
        change19 = () -> :
          running = false
        setState(change19)

  finishLesson() async -> void:
    if saving or store == null: return
    lesson = catalog[currentLesson]
    if choice != lesson.correct: return
    change20 = () -> :
      saving = true
    setState(change20)
    try:
      await store!.complete(lesson.id)
      await storage!.save(store!.image())
      ids = await store!.completedIds()
      if not mounted: return
      change21 = () -> :
        completed = ids
      setState(change21)
    catch error:
      if mounted:
        change22 = () -> :
          notice = tr("Progress was not saved. Please retry before leaving.",
          "لم يُحفظ التقدّم. أعد المحاولة قبل المغادرة.")
        setState(change22)
    finally:
      if mounted:
        change23 = () -> :
          saving = false
        setState(change23)

  resetProgress() async -> void:
    if saving or store == null: return
    change24 = () -> :
      saving = true
    setState(change24)
    try:
      await store!.reset()
      await storage!.save(store!.image())
      if not mounted: return
      change25 = () -> :
        completed = []
        confirmReset = false
      setState(change25)
    catch error:
      if mounted:
        change26 = () -> :
          notice = tr("Could not reset progress. Please try again.",
          "تعذّرت إعادة ضبط التقدّم. حاول مجددًا.")
        setState(change26)
    finally:
      if mounted:
        change27 = () -> :
          saving = false
        setState(change27)

  cancelReset() -> void:
    change = () -> :
      confirmReset = false
    setState(change)

  askReset() -> void:
    change = () -> :
      confirmReset = true
    setState(change)

  nextLesson() -> int:
    for index in 0..<catalog.length:
      if not completed.contains(catalog[index].id): return index
    return 0

  pageTitle() -> String:
    titles = [tr("Your learning studio", "مساحتك للتعلّم"),
    tr("The learning path", "مسار التعلّم"), tr("The language, at a glance",
    "اللغة أمامك بوضوح"), tr("Every step counts", "كل خطوة تصنع فرقًا"),
    tr("Live Quds Playground", "مختبر قدس التفاعلي")]
    return titles[page]

  brandMark(context: BuildContext) -> Widget:
    name = Column(crossAxisAlignment: CrossAxisAlignment.start,
    mainAxisSize: MainAxisSize.min, children: [Text(tr("Quds Academy",
    "أكاديمية قدس"), maxLines: 1, overflow: TextOverflow.ellipsis, style: TextStyle(fontSize: 17.0, fontWeight: FontWeight.w800, color: ink(context))), Text("LEARN. BUILD. BECOME.", maxLines: 1, overflow: TextOverflow.ellipsis, style: TextStyle(fontSize: 8.0, letterSpacing: 1.8, color: muted(context)))])
    logo = Container(width: 40.0, height: 40.0,
    decoration: BoxDecoration(color: brand(),
    borderRadius: BorderRadius.circular(13.0)), child: Icon(Icons.code_rounded,
    color: Colors.white, size: 25.0))
    return Row(children: [logo, SizedBox(width: 10.0), Expanded(child: name)])

