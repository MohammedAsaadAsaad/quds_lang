# Same market-day program as examples/catalog.dart.

class Product:
  sku: String required
  cents: int required
  stock: int required
  value() -> int = cents * stock
  low() -> bool = stock < 5

class CartLine:
  units: int required
  cents: int required
  total() -> int = units * cents

class Shift:
  start: int required
  end: int required

  minutes() -> int:
    if end >= start:
      return end - start
    return end + 1440 - start

sumList(values: List<int>) -> int:
  var total = 0
  for value in values:
    total += value
  return total
minList(values: List<int>) -> int:
  var best = values[0]
  for value in values:
    if value < best:
      best = value
  return best
maxList(values: List<int>) -> int:
  var best = values[0]
  for value in values:
    if value > best:
      best = value
  return best
clampInt(value: int, low: int, high: int) -> int:
  if value < low:
    return low
  if value > high:
    return high
  return value
factorial(n: int) -> int:
  var running = 1
  var cursor = 2
  var limit = n
  if n > 12:
    limit = 12
  while cursor <= limit:
    running *= cursor
    cursor += 1
  return running
fibonacci(n: int) -> int:
  if n <= 1:
    return n
  var previous = 0
  var current = 1
  var left = n - 1
  while left > 0:
    next = previous + current
    previous = current
    current = next
    left -= 1
  return current
gcd(a: int, b: int) -> int:
  var left = a
  var right = b
  if left < 0:
    left = 0 - left
  if right < 0:
    right = 0 - right
  while right != 0:
    rest = left % right
    left = right
    right = rest
  return left
lcm(a: int, b: int) -> int:
  if a == 0 or b == 0:
    return 0
  return a ~/ gcd(a, b) * b
collatzSteps(start: int) -> int:
  var value = start
  var steps = 0
  if value < 1:
    return 0
  while value != 1 and steps < 40:
    if value % 2 == 0:
      value = value ~/ 2
    else:
      value = value * 3 + 1
    steps += 1
  return steps
letterGrade(score: int) -> String:
  if score >= 90:
    return "A"
  if score >= 80:
    return "B"
  if score >= 70:
    return "C"
  if score >= 60:
    return "D"
  return "F"
gpaPoints(score: int) -> int:
  if score >= 90:
    return 4
  if score >= 80:
    return 3
  if score >= 70:
    return 2
  if score >= 60:
    return 1
  return 0
weighted(a: int, b: int, c: int) -> int = (a * 5 + b * 3 + c * 2) ~/ 10
dayOfYear(month: int, day: int) -> int:
  lengths = [31, 28, 31, 30, 31, 30, 31, 31, 30, 31, 30, 31]
  var cursor = 1
  var total = day
  while cursor < month and cursor <= 12:
    total += lengths[cursor - 1]
    cursor += 1
  return total
daysInMonth(month: int) -> int:
  if month == 2:
    return 28
  if month == 4 or month == 6 or month == 9 or month == 11:
    return 30
  return 31
roundDiv(cents: int, rate: int) -> int:
  base = cents * rate
  whole = base ~/ 100
  if base % 100 >= 50:
    return whole + 1
  return whole
tipOf(cents: int, percent: int) -> int = roundDiv(cents, percent)
splitBill(cents: int, people: int) -> int:
  if people <= 0:
    return cents
  share = cents ~/ people
  if cents % people == 0:
    return share
  return share + 1
changeDue(paid: int, owed: int) -> int:
  if paid <= owed:
    return 0
  return paid - owed
margin(price: int, cost: int) -> int:
  if price <= 0:
    return 0
  return (price - cost) * 100 ~/ price
markup(cost: int, percent: int) -> int = cost + cost * percent ~/ 100
reorderQty(stock: int, target: int) -> int:
  if stock >= target:
    return 0
  return target - stock
rectangleArea(width: int, height: int) -> int:
  if width < 0 or height < 0:
    return 0
  return width * height
rectanglePerimeter(width: int, height: int) -> int = (width + height) * 2
overlapLength(a0: int, a1: int, b0: int, b1: int) -> int:
  var start = b0
  if a0 > b0:
    start = a0
  var end = b1
  if a1 < b1:
    end = a1
  if end <= start:
    return 0
  return end - start
distanceSquared(x0: int, y0: int, x1: int, y1: int) -> int:
  dx = x1 - x0
  dy = y1 - y0
  return dx * dx + dy * dy
simpleInterest(principal: int, rate: int, years: int) -> int:
  if years < 0:
    return principal
  return principal + principal * rate * years ~/ 100
compoundSteps(principal: int, rate: int, years: int) -> int:
  var balance = principal
  var left = years
  if left < 0:
    left = 0
  while left > 0:
    balance += balance * rate ~/ 100
    left -= 1
  return balance
payroll(hours: int, rate: int) -> int:
  if hours <= 40:
    return hours * rate
  extra = hours - 40
  return 40 * rate + extra * rate * 3 ~/ 2
netPay(gross: int, taxRate: int) -> int:
  tax = gross * taxRate ~/ 100
  if tax >= gross:
    return 0
  return gross - tax
countChar(text: String, mark: String) -> int:
  if mark.length == 0:
    return 0
  parts = text.split(mark)
  return parts.length - 1
shout(text: String) -> String = text.trim().toUpperCase()
wordScore(text: String) -> int:
  if text.isEmpty:
    return 0
  return text.trim().length + text.indexOf("a")
boolBit(value: bool) -> int:
  if value:
    return 1
  return 0
opensWith(text: String, prefix: String) -> bool = text.startsWith(prefix)
appleTier(units: int, cents: int) -> int:
  if units >= 24:
    return cents * units * 80 ~/ 100
  if units >= 12:
    return cents * units * 90 ~/ 100
  return cents * units
breadTier(units: int, cents: int) -> int:
  if units >= 20:
    return cents * units * 85 ~/ 100
  if units >= 10:
    return cents * units * 95 ~/ 100
  return cents * units
milkTier(units: int, cents: int) -> int:
  if units >= 18:
    return cents * units * 88 ~/ 100
  if units >= 6:
    return cents * units * 94 ~/ 100
  return cents * units
riceTier(units: int, cents: int) -> int:
  if units >= 30:
    return cents * units * 75 ~/ 100
  if units >= 10:
    return cents * units * 90 ~/ 100
  return cents * units
oilTier(units: int, cents: int) -> int:
  if units >= 12:
    return cents * units * 82 ~/ 100
  if units >= 4:
    return cents * units * 92 ~/ 100
  return cents * units
soapTier(units: int, cents: int) -> int:
  if units >= 16:
    return cents * units * 84 ~/ 100
  if units >= 8:
    return cents * units * 93 ~/ 100
  return cents * units
saltTier(units: int, cents: int) -> int:
  if units >= 40:
    return cents * units * 70 ~/ 100
  if units >= 20:
    return cents * units * 85 ~/ 100
  return cents * units
honeyTier(units: int, cents: int) -> int:
  if units >= 8:
    return cents * units * 90 ~/ 100
  if units >= 4:
    return cents * units * 96 ~/ 100
  return cents * units
teaTier(units: int, cents: int) -> int:
  if units >= 15:
    return cents * units * 86 ~/ 100
  if units >= 5:
    return cents * units * 94 ~/ 100
  return cents * units
coffeeTier(units: int, cents: int) -> int:
  if units >= 10:
    return cents * units * 83 ~/ 100
  if units >= 4:
    return cents * units * 91 ~/ 100
  return cents * units
flourTier(units: int, cents: int) -> int:
  if units >= 25:
    return cents * units * 78 ~/ 100
  if units >= 10:
    return cents * units * 90 ~/ 100
  return cents * units
sugarTier(units: int, cents: int) -> int:
  if units >= 22:
    return cents * units * 80 ~/ 100
  if units >= 8:
    return cents * units * 92 ~/ 100
  return cents * units
northShip(grams: int, zone: int) -> int:
  var fee = 25
  if grams >= 2000:
    fee = 90
  else if grams >= 800:
    fee = 55
  if zone > 1:
    fee += zone * 15
  return fee
southShip(grams: int, zone: int) -> int:
  var fee = 20
  if grams >= 1800:
    fee = 80
  else if grams >= 700:
    fee = 50
  if zone > 1:
    fee += zone * 15
  return fee
eastShip(grams: int, zone: int) -> int:
  var fee = 30
  if grams >= 2500:
    fee = 110
  else if grams >= 1000:
    fee = 60
  if zone > 1:
    fee += zone * 15
  return fee
westShip(grams: int, zone: int) -> int:
  var fee = 18
  if grams >= 1500:
    fee = 70
  else if grams >= 600:
    fee = 45
  if zone > 1:
    fee += zone * 15
  return fee
portShip(grams: int, zone: int) -> int:
  var fee = 35
  if grams >= 3000:
    fee = 140
  else if grams >= 1200:
    fee = 75
  if zone > 1:
    fee += zone * 15
  return fee
hillShip(grams: int, zone: int) -> int:
  var fee = 15
  if grams >= 1200:
    fee = 65
  else if grams >= 500:
    fee = 40
  if zone > 1:
    fee += zone * 15
  return fee
rentLate(days: int, due: int) -> int:
  if days <= 3:
    return 0
  extra = (days - 3) * 15
  if extra > due * 20 ~/ 100:
    return due * 20 ~/ 100
  return extra
stallLate(days: int, due: int) -> int:
  if days <= 2:
    return 0
  extra = (days - 2) * 10
  if extra > due * 25 ~/ 100:
    return due * 25 ~/ 100
  return extra
crateLate(days: int, due: int) -> int:
  if days <= 5:
    return 0
  extra = (days - 5) * 8
  if extra > due * 15 ~/ 100:
    return due * 15 ~/ 100
  return extra
coolerLate(days: int, due: int) -> int:
  if days <= 1:
    return 0
  extra = (days - 1) * 20
  if extra > due * 30 ~/ 100:
    return due * 30 ~/ 100
  return extra
licenseLate(days: int, due: int) -> int:
  if days <= 7:
    return 0
  extra = (days - 7) * 12
  if extra > due * 10 ~/ 100:
    return due * 10 ~/ 100
  return extra
clerkBonus(score: int, base: int) -> int:
  if score >= 95:
    return base * 20 ~/ 100
  if score >= 80:
    return base * 10 ~/ 100
  return 0
bakerBonus(score: int, base: int) -> int:
  if score >= 90:
    return base * 15 ~/ 100
  if score >= 75:
    return base * 8 ~/ 100
  return 0
driverBonus(score: int, base: int) -> int:
  if score >= 98:
    return base * 25 ~/ 100
  if score >= 85:
    return base * 12 ~/ 100
  return 0
buyerBonus(score: int, base: int) -> int:
  if score >= 88:
    return base * 18 ~/ 100
  if score >= 70:
    return base * 9 ~/ 100
  return 0
ripeSum(values: List<int>) -> int:
  var total = 0
  for value in values:
    if value > 5:
      total += value
  return total
heavySum(values: List<int>) -> int:
  var total = 0
  for value in values:
    if value > 20:
      total += value
  return total
warmSum(values: List<int>) -> int:
  var total = 0
  for value in values:
    if value > 30:
      total += value
  return total
loudSum(values: List<int>) -> int:
  var total = 0
  for value in values:
    if value > 2:
      total += value
  return total
tallSum(values: List<int>) -> int:
  var total = 0
  for value in values:
    if value > 100:
      total += value
  return total
plainDigits(number: int) -> int:
  var rest = number
  if rest < 0:
    rest = 0 - rest
  var total = 0
  while rest > 0:
    total += (rest % 10) * 1
    rest = rest ~/ 10
  return total
doubleDigits(number: int) -> int:
  var rest = number
  if rest < 0:
    rest = 0 - rest
  var total = 0
  while rest > 0:
    total += (rest % 10) * 2
    rest = rest ~/ 10
  return total
tripleDigits(number: int) -> int:
  var rest = number
  if rest < 0:
    rest = 0 - rest
  var total = 0
  while rest > 0:
    total += (rest % 10) * 3
    rest = rest ~/ 10
  return total
rateAppleCrate(units: int) -> int = units * 100 + 0
rateBreadCrate(units: int) -> int = units * 101 + 1
