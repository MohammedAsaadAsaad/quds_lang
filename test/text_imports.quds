use quds:text::types show TextRange, TextBoundaryPolicy
use quds:text::builder show TextBuilder
use quds:text::split as split
use quds:text::compose as compose
use quds:text::lines as lines
use quds:text::inspect as inspect
use quds:text::slice as slice
use quds:ext

test "selective section imports, prefixes, show, and quds:ext coexistence":
  expect(TextBoundaryPolicy.reject != TextBoundaryPolicy.next, true)
  r = TextRange(0, 4)
  expect(slice.sliceText("QudsLang", r) == "Quds", true)

  b = TextBuilder()
  b.append("Hello")
  b.appendLine(" Quds")
  b.appendJoined(["a", "b", "c"], separator: ", ")
  expect(b.build() == "Hello Quds\na, b, c", true)

  part = split.splitTextOnce("name=a=b", "=")
  expect(part.before == "name", true)
  expect(part.after == "a=b", true)
  expect(part.found, true)

  expect(compose.repeatText("some", 3, separator: "-") == "some-some-some", true)
  expect(lines.normalizeLineEndings("x\r\ny", ending: lines.TextLineEnding.lf) == "x\ny", true)
  expect(inspect.isBlankText("  \t "), true)
  expect(4.even(), true)
