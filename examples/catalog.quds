digest() -> int:
  product = Product(sku: "A1", cents: 250, stock: 4)
  line = CartLine(units: 3, cents: 40)
  shift = Shift(start: 22 * 60, end: 6 * 60)
  lowBit = 1 if product.low() else 0
  sample = [3, 8, 1, 9]
  parts = [
    sumList([4, 5, 6]),
    minList([4, 1, 7]),
    maxList([4, 1, 7]),
    clampInt(12, 0, 9),
    factorial(6),
    fibonacci(10),
    gcd(48, 18),
    lcm(12, 18),
    collatzSteps(12),
    letterGrade(92).length,
    gpaPoints(75),
    weighted(80, 90, 70),
    dayOfYear(3, 1),
    daysInMonth(2),
    roundDiv(199, 15),
    tipOf(2000, 10),
    splitBill(1000, 3),
    changeDue(500, 320),
    margin(250, 180),
    markup(180, 25),
    reorderQty(4, 12),
    rectangleArea(6, 4),
    rectanglePerimeter(6, 4),
    overlapLength(1, 5, 3, 8),
    distanceSquared(1, 2, 4, 6),
    simpleInterest(1000, 5, 2),
    compoundSteps(1000, 10, 2),
    payroll(42, 20),
    netPay(800, 10),
    countChar("a-b-c", "-"),
    shout("  ada ").length,
    wordScore("ada"),
    boolBit(true),
    boolBit(opensWith("market", "mar")),
    appleTier(10, 40),
    breadTier(10, 40),
    milkTier(10, 40),
    riceTier(10, 40),
    oilTier(10, 40),
    soapTier(10, 40),
    saltTier(10, 40),
    honeyTier(10, 40),
    teaTier(10, 40),
    coffeeTier(10, 40),
    flourTier(10, 40),
    sugarTier(10, 40),
    northShip(900, 2),
    southShip(900, 2),
    eastShip(900, 2),
    westShip(900, 2),
    portShip(900, 2),
    hillShip(900, 2),
    rentLate(12, 500),
    stallLate(12, 500),
    crateLate(12, 500),
    coolerLate(12, 500),
    licenseLate(12, 500),
    clerkBonus(88, 200),
    bakerBonus(88, 200),
    driverBonus(88, 200),
    buyerBonus(88, 200),
    ripeSum(sample),
    heavySum(sample),
    warmSum(sample),
    loudSum(sample),
    tallSum(sample),
    plainDigits(2468),
    doubleDigits(2468),
    tripleDigits(2468),
    rateAppleCrate(3),
