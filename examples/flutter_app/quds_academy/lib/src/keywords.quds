    KeywordEntry(r'''enum''', r'''Declares an enumeration with constant cases. Enumerations support fields, constructors and exhaustive matching.''', r'''تعداد بحالات ثابتة وحقول وبناة، مع دعم المطابقة الشاملة.''', r'''enum Color:
  red
