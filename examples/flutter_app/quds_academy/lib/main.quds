      selected = page == index
      entries.add(Padding(padding: EdgeInsets.only(bottom: 9.0),
      child: Material(color: (if (selected): (brand().withValues(alpha: 0.09)) else: (Colors.transparent)), borderRadius: BorderRadius.circular(13.0), child: ListTile(dense: true, shape: RoundedRectangleBorder(borderRadius: BorderRadius.circular(13.0)), leading: Icon(icons[index], color: (if (selected): (brand()) else: (muted(context))), size: 21.0), title: Text(labels[index], style: TextStyle(fontWeight: FontWeight.w600, fontSize: 14.0, color: (if (selected): (brand()) else: (ink(context))))), onTap: () -> selectPage(index)))))
    return Container(width: 248.0,
    decoration: BoxDecoration(color: surface(context),
    border: BorderDirectional(end: BorderSide(color: lineColor(context)))), padding: EdgeInsets.fromLTRB(24.0, 30.0, 24.0, 24.0), child: Column(crossAxisAlignment: CrossAxisAlignment.start, children: [brandMark(context), SizedBox(height: 46.0), Text(tr("YOUR WORKSPACE", "مساحتك الخاصة"), style: TextStyle(fontSize: 10.0, letterSpacing: 1.4, fontWeight: FontWeight.w600, color: muted(context))), SizedBox(height: 18.0), ...entries, Spacer(), Container(padding: EdgeInsets.all(18.0), decoration: BoxDecoration(color: brand().withValues(alpha: 0.07), borderRadius: BorderRadius.circular(18.0)), child: Column(crossAxisAlignment: CrossAxisAlignment.start, children: [Icon(Icons.eco_outlined, color: brand(), size: 25.0), SizedBox(height: 10.0), Text(tr("A little, every day.", "قليلٌ، كل يوم."), style: TextStyle(fontWeight: FontWeight.w700, fontSize: 14.0, color: ink(context))), SizedBox(height: 5.0), prose(context, tr("Big ideas grow from small, consistent steps.", "تنمو الأفكار الكبيرة بخطوات صغيرة مستمرة."))])), SizedBox(height: 22.0), Text(tr("Made with Quds + Flutter", "بُني بقدس + Flutter"), style: TextStyle(fontSize: 10.0, color: muted(context)))]))

  header(context: BuildContext, wide: bool) -> Widget:
    return Container(padding: EdgeInsets.symmetric(horizontal: 24.0,
    vertical: 16.0), decoration: BoxDecoration(border: Border(bottom: BorderSide(color: lineColor(context)))), child: Row(children: [if not wide: Expanded(child: brandMark(context)), if wide: Expanded(child: Column(crossAxisAlignment: CrossAxisAlignment.start, children: [Text(tr("A fresh page. A new possibility.", "صفحة جديدة، وإمكانية جديدة."), style: TextStyle(fontSize: 12.0, color: muted(context))), SizedBox(height: 3.0), heading(context, pageTitle(), 19.0)])), Tooltip(message: tr("Change language", "تغيير اللغة"), child: OutlinedButton(onPressed: (if (saving): (null) else: (switchLanguage)), style: OutlinedButton.styleFrom(side: BorderSide(color: lineColor(context)), padding: EdgeInsets.symmetric(horizontal: 13.0, vertical: 11.0)), child: Text((if (arabic): ("EN") else: ("عربي")), style: TextStyle(fontSize: 12.0, fontWeight: FontWeight.w700)))), SizedBox(width: 8.0), IconButton(tooltip: tr("Toggle appearance", "تبديل المظهر"), onPressed: (if (saving): (null) else: (switchTheme)), icon: Icon((if (dark): (Icons.light_mode_outlined) else: (Icons.dark_mode_outlined)), size: 21.0))]))

  searchBox(context: BuildContext) -> Widget:
    return TextField(controller: search, onChanged: updateSearch,
    decoration: InputDecoration(hintText: tr("Find a lesson or a keyword…",
    "ابحث عن درس أو كلمة…"), prefixIcon: Icon(Icons.search_rounded,
    size: 21.0), filled: true, fillColor: surface(context), hintStyle: TextStyle(fontSize: 13.0, color: muted(context)), border: OutlineInputBorder(borderRadius: BorderRadius.circular(14.0), borderSide: BorderSide(color: lineColor(context))), enabledBorder: OutlineInputBorder(borderRadius: BorderRadius.circular(14.0), borderSide: BorderSide(color: lineColor(context))), contentPadding: EdgeInsets.symmetric(horizontal: 18.0, vertical: 17.0)))

