    KeywordEntry(r'''interface''', r'''Declares an interface, or restricts a class to implementation by outside libraries when used as interface class.''', r'''تعريف واجهة أو تقييد كلاس للتنفيذ من المكتبات الخارجية عند كتابة interface class.''', r'''interface Named:
  name: String'''),
    KeywordEntry(r'''final''', r'''Restricts class subtyping outside its library. This is a class modifier; ordinary immutable bindings use name = value.''', r'''منع التصنيف الفرعي للكلاس من خارج مكتبته؛ ليست صيغة ارتباط محلي ثابت.''', r'''final class Token:
